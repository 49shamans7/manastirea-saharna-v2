{
  "name": "manastirea-saharna-v2",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev:client": "bun run --cwd apps/client dev",
    "build:client": "bun run --cwd apps/client build",
    "preview:client": "bun run --cwd apps/client preview",
    "check:workers": "tsc -p workers/saharna-pomelnic && bun test workers/saharna-pomelnic",
    "cloudflare:setup": "bun scripts/cloudflare-setup.mjs"
  },
  "devDependencies": {
    "playwright-core": "^1.63.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.2",
    "wrangler": "^4.146.0"
  }
}
