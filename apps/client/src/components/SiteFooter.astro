---
import type { Locale } from "@i18n";
import { getLocalizedPath, telHref, useTranslations } from "@i18n/utils";
import Icon from "@components/marks/Icon.astro";
import Ornament from "@components/ornament/Ornament.astro";

type Props = {
  lang: Locale;
};

const { lang } = Astro.props;
const t = useTranslations(lang);
// The descent ends here: the olive bar, quiet. One tracked line of links —
// every zone reachable from the bottom of any page, every link a real route —
// then where the house is and how to reach it (the phone once), then the
// copyright and the three channels.
const footerLinks = [
  { key: "zone.istoria", href: "/istoria" },
  { key: "zone.obstea", href: "/obstea" },
  { key: "zone.macarie", href: "/macarie" },
  { key: "zone.cronica", href: "/posts" },
  { key: "nav.serviceSchedule", href: "/slujbe" },
  { key: "nav.directions", href: "/cum-de-ajuns" },
  { key: "zone.cazare", href: "/cazare" },
  { key: "nav.contact", href: "/contact" },
  { key: "nav.pomelnic", href: "/pomelnic" },
  { key: "nav.donations", href: "/donations" },
  { key: "search.title", href: "/cautare" },
] as const;
const email = t("footer.email").split(",")[0]?.trim() ?? "";
const phone = t("contact.phoneSecretariat");
const socialLinks = [
  { key: "social.youtube", href: "https://www.youtube.com/@manastirea.saharna", icon: "youtube", mark: "" },
  { key: "social.facebook", href: "https://www.facebook.com/ManastireaSaharna/", icon: "text", mark: "f" },
  { key: "social.tiktok", href: "https://www.tiktok.com/@monklife?_r=1&_t=ZS-972uTnfFdwq", icon: "tiktok", mark: "" },
] as const;
---

<footer class="footer">
  <div class="frame-wide end">
    {/* hairline · quatrefoil · hairline: the tracery foil closes the page */}
    <span class="r-foil foil" aria-hidden="true"><Ornament name="quatrefoil" /></span>
    <p class="title">{t("main.title")}</p>
    <nav class="links" aria-label={t("nav.menu")}>
      <ul>
        {
          footerLinks.map((item) => (
            <li>
              <a href={getLocalizedPath(item.href, lang)}>{t(item.key)}</a>
            </li>
          ))
        }
      </ul>
    </nav>
    <address>
      <span>{t("footer.addressLine")}</span>
      <a href={telHref(phone)}>{phone}</a>
      <a href={`mailto:${email}`}>{email}</a>
    </address>
    <div class="base">
      <p class="copyright">{t("footer.copyright")}</p>
      <nav class="social" aria-label={t("social.label")}>
        {
          socialLinks.map((item) => (
            <a href={item.href} aria-label={t(item.key)} title={t(item.key)} target="_blank" rel="noreferrer">
              {item.icon === "youtube" ? (
                <Icon name="youtube" size={18} />
              ) : item.icon === "tiktok" ? (
                <Icon name="tiktok" size={18} />
              ) : (
                <span aria-hidden="true">{item.mark}</span>
              )}
            </a>
          ))
        }
      </nav>
    </div>
  </div>
</footer>

<style>
  /* the olive bar again, closing what the header opened: no lintel, one
     opaque gold hairline, a quatrefoil, everything on the axis */
  .footer {
    /* above any fixed layer a page lays under its content (the landing's shaft) */
    position: relative;
    z-index: 2;
    padding: var(--s-9) 0 var(--s-5);
    border-top: var(--rule) solid var(--seal-gold);
    background: var(--header);
    color: var(--header-ink);
    font-size: var(--t-meta);
    line-height: 1.5;
    text-align: center;
  }
  .end {
    display: grid;
    justify-items: center;
  }
  .foil {
    margin-bottom: var(--s-5);
  }
  .title {
    margin: 0 0 var(--s-5);
    color: var(--seal-paper);
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 18px;
    line-height: 1.3;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  /* one tracked line of links; it wraps on a phone, never into a box */
  .links ul {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0 var(--s-5);
    max-width: 60rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .links a {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap-min);
    color: var(--header-ink);
    font-size: 11px;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    text-decoration: none;
    transition: color var(--dur-1) var(--ease-out);
  }
  .links a:hover,
  address a:hover {
    color: var(--header-gold);
    text-decoration: underline;
    text-decoration-thickness: var(--rule);
    text-underline-offset: 0.3em;
  }

  address {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 0 var(--s-5);
    margin-top: var(--s-5);
    padding-top: var(--s-4);
    border-top: var(--rule) solid var(--header-line);
    font-style: normal;
  }
  address a {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap-min);
    color: var(--header-ink);
    text-decoration: none;
    font-variant-numeric: lining-nums;
  }

  .base {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 0 var(--s-5);
    margin-top: var(--s-4);
  }
  .copyright {
    margin: 0;
    font-size: 13px;
    color: var(--header-ink);
  }
  .social {
    display: flex;
    align-items: center;
  }
  .social a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: var(--tap);
    height: var(--tap);
    color: var(--header-ink);
    font-size: 17px;
    font-weight: 700;
    text-decoration: none;
    transition: color var(--dur-1) var(--ease-out);
  }
  .social a:hover {
    color: var(--header-gold);
  }
  .footer :focus-visible {
    outline: var(--rule-2) solid var(--header-gold);
    outline-offset: var(--rule-2);
  }

  @media (width < 40rem) {
    .footer {
      padding-top: var(--s-8);
    }
    .links ul {
      gap: 0 var(--s-4);
    }
    address {
      flex-direction: column;
      gap: 0;
    }
    address span {
      max-width: 22rem;
      margin-bottom: var(--s-1);
    }
  }
</style>
