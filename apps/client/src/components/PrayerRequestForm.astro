---
import { useTranslations } from "@i18n/utils";
import type { Locale } from "@i18n";

type Props = {
  idPrefix: string;
  lang: Locale;
};

const { idPrefix, lang } = Astro.props;
const t = useTranslations(lang);
const pomelnicWorkerUrl = import.meta.env.PUBLIC_POMELNIC_WORKER_URL;
const turnstileSiteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY;
const formAction = pomelnicWorkerUrl
  ? pomelnicWorkerUrl.startsWith("http")
    ? pomelnicWorkerUrl
    : `https://${pomelnicWorkerUrl}`
  : "#";
const redirectUrl = `${Astro.url.origin}${Astro.url.pathname}#pomelnic-form`;
---

<form class="f-form" action={formAction} method="post">
  <input type="hidden" name="redirect" value={redirectUrl} />
  <input type="hidden" name="language" value={lang} />
  <input class="f-trap" type="checkbox" name="botcheck" tabindex="-1" autocomplete="off" />

  <p
    class="f-status"
    hidden
    data-pomelnic-status
    id={`${idPrefix}-status`}
    role="status"
    aria-live="polite"
    data-success={t("pomelnic.success")}
    data-challenge={t("pomelnic.challengeError")}
    data-send={t("pomelnic.sendError")}
    data-invalid={t("pomelnic.invalidError")}
    data-error={t("pomelnic.error")}>
  </p>

  <div class="f-pair">
    <label class="f-label" for={`${idPrefix}-name`}>
      {t("pomelnic.name")}
      <span class="f-required">*</span>
      <span class="f-help">{t("pomelnic.nameHelp")}</span>
      <input class="f-field" id={`${idPrefix}-name`} name="name" type="text" autocomplete="name" required />
    </label>

    <label class="f-label" for={`${idPrefix}-email`}>
      {t("pomelnic.email")}
      <span class="f-required">*</span>
      <span class="f-help">{t("pomelnic.emailHelp")}</span>
      <input class="f-field" id={`${idPrefix}-email`} name="email" type="email" autocomplete="email" required />
    </label>
  </div>

  <div class="f-pair">
    <label class="f-label" for={`${idPrefix}-living`}>
      {t("pomelnic.living")}
      <textarea
        class="f-field"
        id={`${idPrefix}-living`}
        name="living_names"
        placeholder={t("pomelnic.livingPlaceholder")}></textarea>
    </label>

    <label class="f-label" for={`${idPrefix}-departed`}>
      {t("pomelnic.departed")}
      <textarea
        class="f-field"
        id={`${idPrefix}-departed`}
        name="departed_names"
        placeholder={t("pomelnic.departedPlaceholder")}></textarea>
    </label>
  </div>

  <label class="f-label" for={`${idPrefix}-message`}>
    {t("pomelnic.message")}
    <textarea class="f-field" id={`${idPrefix}-message`} name="message" placeholder={t("pomelnic.messagePlaceholder")}
    ></textarea>
  </label>

  {turnstileSiteKey && <div class="cf-turnstile f-turnstile" data-sitekey={turnstileSiteKey} data-theme="light" />}

  <div class="f-actions">
    <p class="f-note">{t("pomelnic.requiredHelp")}</p>
    <button class="f-submit" type="submit">{t("pomelnic.submit")}</button>
  </div>
</form>

{turnstileSiteKey && <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer />}

<script is:inline>
  (() => {
    const status = new URLSearchParams(window.location.search).get("pomelnic");
    if (status) {
      document.querySelectorAll("[data-pomelnic-status]").forEach((element) => {
        const isSuccess = status === "ok";
        element.textContent = isSuccess ? element.dataset.success : element.dataset[status] || element.dataset.error;
        element.dataset.status = isSuccess ? "success" : "error";
        element.hidden = false;
      });
    }
  })();
</script>

<style>
  /* Neutral form. The page that holds it sets the ground (pomelnic.astro: the
     well) and overrides label, field and button colours from there. */
  .f-form,
  .f-pair {
    display: grid;
    gap: var(--s-6) var(--s-5);
  }
  @media (min-width: 768px) {
    .f-pair {
      grid-template-columns: 1fr 1fr;
    }
  }
  .f-trap {
    display: none;
  }

  .f-status {
    margin: 0;
    padding: var(--s-3) var(--s-4);
    border-left: var(--bar) solid;
    font-size: var(--t-meta);
    line-height: 1.5;
  }
  .f-status[data-status="error"] {
    border-color: var(--error-line);
    background: var(--error-bg);
    color: var(--error);
  }
  .f-status[data-status="success"] {
    border-color: var(--success-line);
    background: var(--success-bg);
    color: var(--success);
  }

  .f-label {
    display: block;
    font-size: var(--t-ui);
    line-height: 1.4;
    color: var(--field-label);
  }
  .f-required {
    margin-left: 0.15em;
    color: var(--f-accent, var(--error));
  }
  .f-help {
    display: block;
    padding-top: var(--s-1);
    font-size: var(--t-meta);
    line-height: 1.45;
    font-style: italic;
    color: var(--field-muted);
  }

  .f-field {
    display: block;
    width: 100%;
    margin-top: var(--s-2);
    min-height: var(--tap);
    padding: var(--s-3) var(--s-4);
    border: var(--rule) solid var(--field-line);
    background: var(--paper);
    color: var(--field-ink);
    font: inherit;
    font-size: 16px; /* 16px: iOS does not zoom into the field */
    line-height: 24px;
    font-weight: 400;
    transition:
      border-color var(--dur-1) var(--ease-out),
      background-color var(--dur-1) var(--ease-out);
  }
  .f-field:hover {
    border-color: var(--field-ink);
  }
  .f-field:focus {
    border-color: var(--header);
    outline: var(--rule-2) solid var(--header);
    outline-offset: 0;
  }
  textarea.f-field {
    min-height: 144px;
    max-height: 280px;
    resize: vertical;
  }

  .f-turnstile {
    min-height: 65px;
  }

  .f-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-5);
    padding-top: var(--s-2);
  }
  .f-note {
    flex: 1 1 18rem;
    margin: 0;
    max-width: 32rem;
    font-size: var(--t-meta);
    line-height: 1.55;
    color: var(--field-muted);
  }
  .f-submit {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: var(--tap);
    padding: 0 var(--s-6);
    border: var(--rule) solid var(--header);
    background: var(--header);
    color: var(--paper);
    font: inherit;
    font-size: var(--t-ui);
    letter-spacing: 0.01em;
    cursor: pointer;
    transition:
      background-color var(--dur-1) var(--ease-out),
      border-color var(--dur-1) var(--ease-out),
      color var(--dur-1) var(--ease-out);
  }
</style>
