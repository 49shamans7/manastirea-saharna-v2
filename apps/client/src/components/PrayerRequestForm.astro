---
import { useTranslations } from "@i18n/utils";
import type { Locale } from "@i18n";

type Props = {
  idPrefix: string;
  lang: Locale;
};

const { idPrefix, lang } = Astro.props;
const t = useTranslations(lang);
const pomelnicWorkerUrl = import.meta.env.PUBLIC_POMELNIC_WORKER_URL;
const turnstileSiteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY;
const formAction = pomelnicWorkerUrl
  ? pomelnicWorkerUrl.startsWith("http")
    ? pomelnicWorkerUrl
    : `https://${pomelnicWorkerUrl}`
  : "#";
const redirectUrl = `${Astro.url.origin}${Astro.url.pathname}#pomelnic-form`;
---

<form class="f-form" action={formAction} method="post">
  <input type="hidden" name="redirect" value={redirectUrl} />
  <input type="hidden" name="language" value={lang} />
  <input class="f-trap" type="checkbox" name="botcheck" tabindex="-1" autocomplete="off" />

  <p
    class="f-status"
    hidden
    data-pomelnic-status
    id={`${idPrefix}-status`}
    role="status"
    aria-live="polite"
    data-success={t("pomelnic.success")}
    data-challenge={t("pomelnic.challengeError")}
    data-send={t("pomelnic.sendError")}
    data-invalid={t("pomelnic.invalidError")}
    data-error={t("pomelnic.error")}>
  </p>

  <div class="f-pair">
    <label class="f-label" for={`${idPrefix}-name`}>
      {t("pomelnic.name")}
      <span class="f-required">*</span>
      <span class="f-help">{t("pomelnic.nameHelp")}</span>
      <input class="f-field" id={`${idPrefix}-name`} name="name" type="text" autocomplete="name" required />
    </label>

    <label class="f-label" for={`${idPrefix}-email`}>
      {t("pomelnic.email")}
      <span class="f-required">*</span>
      <span class="f-help">{t("pomelnic.emailHelp")}</span>
      <input class="f-field" id={`${idPrefix}-email`} name="email" type="email" autocomplete="email" required />
    </label>
  </div>

  <div class="f-pair">
    <label class="f-label" for={`${idPrefix}-living`}>
      {t("pomelnic.living")}
      <textarea
        class="f-field"
        id={`${idPrefix}-living`}
        name="living_names"
        placeholder={t("pomelnic.livingPlaceholder")}></textarea>
    </label>

    <label class="f-label" for={`${idPrefix}-departed`}>
      {t("pomelnic.departed")}
      <textarea
        class="f-field"
        id={`${idPrefix}-departed`}
        name="departed_names"
        placeholder={t("pomelnic.departedPlaceholder")}></textarea>
    </label>
  </div>

  <label class="f-label" for={`${idPrefix}-message`}>
    {t("pomelnic.message")}
    <textarea class="f-field" id={`${idPrefix}-message`} name="message" placeholder={t("pomelnic.messagePlaceholder")}
    ></textarea>
  </label>

  {turnstileSiteKey && <div class="cf-turnstile f-turnstile" data-sitekey={turnstileSiteKey} data-theme="light" />}

  <div class="f-actions">
    <p class="f-note">{t("pomelnic.requiredHelp")}</p>
    <button class="f-submit" type="submit">{t("pomelnic.submit")}</button>
  </div>
</form>

{turnstileSiteKey && <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer />}

<script is:inline>
  (() => {
    const status = new URLSearchParams(window.location.search).get("pomelnic");
    if (status) {
      document.querySelectorAll("[data-pomelnic-status]").forEach((element) => {
        const isSuccess = status === "ok";
        element.textContent = isSuccess ? element.dataset.success : element.dataset[status] || element.dataset.error;
        element.dataset.status = isSuccess ? "success" : "error";
        element.hidden = false;
      });
    }
  })();
</script>

<style>
  /* Neutral form, in the table's language: tracked caps labels, square
     fields, a square tracked-caps button. The page that holds it sets the
     ground (pomelnic.astro: the navy shaft) and re-points these properties:
     --field-label --field-muted --field-ink --field-line --f-accent
     --f-focus --f-button --f-button-ink --f-button-hover --f-placeholder.
     Defaults are for a white ground (navy ink, AA throughout). */
  .f-form,
  .f-pair {
    display: grid;
    gap: 28px 24px;
  }
  @media (min-width: 768px) {
    .f-pair {
      grid-template-columns: 1fr 1fr;
    }
  }
  .f-trap {
    display: none;
  }

  .f-status {
    margin: 0;
    padding: 14px 16px;
    border-left: 4px solid;
    font-size: 15px;
    line-height: 1.5;
  }
  .f-status[data-status="error"] {
    border-color: var(--error);
    background: var(--error-bg);
    color: var(--error);
  }
  .f-status[data-status="success"] {
    border-color: var(--success);
    background: var(--success-bg);
    color: var(--success);
  }

  .f-label {
    display: block;
    font-size: 11px;
    line-height: 1.5;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: var(--field-label, #1a3346);
  }
  .f-required {
    margin-left: 0.15em;
    color: var(--f-accent, var(--error));
  }
  .f-help {
    display: block;
    padding-top: 4px;
    font-size: 14px;
    line-height: 1.45;
    letter-spacing: 0;
    text-transform: none;
    font-style: italic;
    color: var(--field-muted, #4a6274);
  }

  .f-field {
    display: block;
    width: 100%;
    margin-top: 10px;
    min-height: 52px;
    padding: 12px 16px;
    border: 1px solid var(--field-line, #ab9362);
    border-radius: 0;
    background: #fff;
    color: var(--field-ink, #1a3346);
    font: inherit;
    font-size: 16px; /* 16px: iOS does not zoom into the field */
    line-height: 24px;
    letter-spacing: 0;
    text-transform: none;
    font-weight: 400;
    transition: border-color 0.18s ease;
  }
  .f-field::placeholder {
    color: var(--f-placeholder, #5f6b76);
    opacity: 1;
  }
  .f-field:focus {
    border-color: var(--f-focus, #22425a);
    outline: 2px solid var(--f-focus, #22425a);
    outline-offset: 0;
  }
  textarea.f-field {
    min-height: 144px;
    max-height: 280px;
    resize: vertical;
  }

  .f-turnstile {
    min-height: 65px;
  }

  .f-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 20px 24px;
    padding-top: 4px;
  }
  .f-note {
    flex: 1 1 18rem;
    margin: 0;
    max-width: 32rem;
    font-size: 14px;
    line-height: 1.55;
    color: var(--field-muted, #4a6274);
  }
  .f-submit {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 52px;
    padding: 0 28px;
    border: 1px solid var(--f-button, #22425a);
    border-radius: 0;
    background: var(--f-button, #22425a);
    color: var(--f-button-ink, #fff);
    font: inherit;
    font-size: 11px;
    letter-spacing: 0.26em;
    text-transform: uppercase;
    cursor: pointer;
    transition:
      background-color 0.18s ease,
      border-color 0.18s ease;
  }
  .f-submit:hover {
    border-color: var(--f-button-hover, #1a3346);
    background: var(--f-button-hover, #1a3346);
  }
  .f-submit:focus-visible {
    outline: 2px solid var(--f-focus, #22425a);
    outline-offset: 3px;
  }
  @media (max-width: 599px) {
    .f-submit {
      flex: 1 1 100%;
    }
  }
</style>
