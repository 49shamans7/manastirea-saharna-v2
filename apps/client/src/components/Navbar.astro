---
// THE HEADER — the olive bar, the official seal, the name in the seal's own
// lettering (Alegreya SC). The descent index lives in a drawer at every width;
// its one opener sits left of the seal, on the side the drawer slides in from.
import type { Locale } from "@i18n";
import { getLocalizedPath, useTranslations } from "@i18n/utils";
import Icon from "@components/marks/Icon.astro";
import sealHeaderUrl from "@assets/marks/seal-header.svg?url";

type Props = {
  path: string;
  lang: Locale;
};

const { path, lang } = Astro.props;
const t = useTranslations(lang);
// the 404 has no page of its own in other languages: switch to that home
const switchPath = /\/404(\.html)?\/?$/.test(path) ? "/" : path;

const languageItems = [
  { locale: "ro", label: "RO" },
  { locale: "en", label: "EN" },
  { locale: "ru", label: "RU" },
] as const;
---

<header class="bar">
  <div class="frame-wide inner">
    <button
      type="button"
      class="opener"
      data-drawer-open
      aria-label={t("nav.openMenu")}
      aria-controls="rail-drawer"
      aria-expanded="false">
      {/* four strata, not a generic hamburger: the drawer is the descent */}
      <span class="strata" aria-hidden="true"><i></i><i></i><i></i><i></i></span>
    </button>

    <a class="brand" href={getLocalizedPath("/", lang)}>
      {/* the official seal, header cut: its cream silhouette eroded by a
          22-unit stroke in the bar's olive, so no pale rim haloes it */}
      <img class="brand-seal" src={sealHeaderUrl} width="84" height="70" alt="" decoding="async" />
      <span class="brand-name">
        <span>{t("main.logoLineOne")}</span>
        <span>{t("main.logoLineTwo")}</span>
        <span>{t("main.logoLineThree")}</span>
      </span>
    </a>

    <div class="tools">
      <a class="find" href={getLocalizedPath("/cautare", lang)} aria-label={t("search.title")} title={t("search.title")}>
        <Icon name="search" size={20} />
      </a>

      <nav class="langs" aria-label={t("language.label")}>
        {
          languageItems.map((item) => (
            <a
              class:list={["lang", item.locale === lang && "is-current"]}
              href={getLocalizedPath(switchPath, item.locale)}
              lang={item.locale}
              aria-label={`${item.label} · ${t(`language.${item.locale}`)}`}
              aria-current={item.locale === lang ? "page" : undefined}>
              {item.label}
            </a>
          ))
        }
      </nav>
    </div>
  </div>
</header>

<style>
  .bar {
    position: sticky;
    top: 0;
    z-index: 50;
    border-bottom: var(--rule) solid var(--seal-gold);
    background: var(--header);
    color: var(--header-ink);
  }
  .inner {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: var(--s-3);
    height: var(--nav-h);
    /* the opener's 48px target is wider than its mark: pull it to the gutter */
    padding-left: max(calc(var(--frame-pad) - 12px), env(safe-area-inset-left));
  }

  /* no frame round it (owner, v1): four strata in the bar's ink; gold on hover */
  .opener {
    display: inline-grid;
    place-items: center;
    width: var(--tap);
    height: var(--tap);
    padding: 0;
    border: 0;
    background: transparent;
    color: var(--seal-paper);
    cursor: pointer;
    transition: color var(--dur-1) var(--ease-out);
  }
  .opener:hover,
  .opener[aria-expanded="true"] {
    color: var(--header-gold);
  }
  .strata {
    display: grid;
    gap: 4px;
    width: 22px;
  }
  .strata i {
    display: block;
    height: 2px;
    background: currentColor;
  }
  /* the strata widen as they go down, as the gorge does */
  .strata i:nth-child(1) {
    width: 12px;
  }
  .strata i:nth-child(2) {
    width: 16px;
  }
  .strata i:nth-child(3) {
    width: 19px;
  }

  .brand {
    display: flex;
    align-items: center;
    justify-self: start;
    min-height: var(--tap);
    gap: var(--s-3);
    min-width: 0;
    color: var(--seal-paper);
    text-decoration: none;
  }
  .brand-seal {
    flex-shrink: 0;
    width: 84px;
    height: auto;
  }
  .brand-name {
    display: grid;
    gap: 3px;
    font-family: var(--font-display);
    font-size: 14px;
    line-height: 1;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  .brand:hover .brand-name {
    color: var(--header-gold);
  }

  .tools {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: var(--s-4);
  }

  /* one joined strip of three cells on olive hairlines; the current
     language is drawn in outline, in the read-gold */
  .langs {
    display: flex;
    align-items: center;
    font-size: 12px;
    line-height: 16px;
    letter-spacing: 0.2em;
  }
  .lang {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: var(--s-6);
    min-width: var(--s-7);
    margin-left: calc(-1 * var(--rule));
    padding: 0 var(--s-2) 0 calc(var(--s-2) + 0.2em);
    box-sizing: border-box;
    border: var(--rule) solid var(--header-line);
    color: var(--header-ink);
    text-decoration: none;
    transition:
      color var(--dur-1) var(--ease-out),
      border-color var(--dur-1) var(--ease-out);
  }
  .lang:first-child {
    margin-left: 0;
  }
  /* neighbours share a hairline (-1px margins), so the hovered cell rises
     above them or its left edge stays under the next one */
  .lang:hover {
    position: relative;
    z-index: 2;
    border-color: var(--header-ink);
    color: #ffffff;
  }
  .lang.is-current {
    position: relative;
    z-index: 1;
    border-color: var(--header-gold);
    color: var(--header-gold);
  }

  .find {
    display: inline-grid;
    flex-shrink: 0;
    place-items: center;
    width: var(--tap);
    height: var(--tap);
    color: var(--header-ink);
    transition: color var(--dur-1) var(--ease-out);
  }
  .find:hover {
    color: var(--header-gold);
  }

  .bar :focus-visible {
    outline: var(--rule-2) solid var(--header-gold);
    outline-offset: calc(var(--rule-2) * -1);
  }

  @media (width < 1100px) {
    .tools {
      gap: var(--s-2);
    }
  }
  @media (width < 40rem) {
    .inner {
      gap: var(--s-2);
      padding-right: max(calc(var(--frame-pad) - 4px), env(safe-area-inset-right));
    }
    /* no room beside the name: search moves into the drawer */
    .find {
      display: none;
    }
    .brand {
      gap: var(--s-2);
    }
    .brand-seal {
      width: 60px;
    }
    .brand-name {
      font-size: 11px;
      letter-spacing: 0.08em;
    }
    /* on a phone the cells lose their frames: the current one keeps its
       outline; each is a full thumb's target */
    .lang {
      height: var(--tap-min);
      min-width: var(--tap-min);
      padding: 0 0 0 0.2em;
      margin-left: 0;
      border-color: transparent;
    }
  }
  @media (width < 380px) {
    .brand-seal {
      width: 52px;
    }
    .brand-name {
      letter-spacing: 0.04em;
    }
  }
</style>
