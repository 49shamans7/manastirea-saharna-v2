---
// THE HEADER — the olive bar, the official seal, the name in the seal's own
// lettering (Alegreya SC). The descent index lives in a drawer at every width;
// its one opener sits left of the seal, on the side the drawer slides in from.
import type { Locale } from "@i18n";
import { getLocalizedPath, useTranslations } from "@i18n/utils";
import Icon from "@components/marks/Icon.astro";
import sealHeaderUrl from "@assets/marks/seal.svg?url";

type Props = {
  path: string;
  lang: Locale;
};

const { path, lang } = Astro.props;
const t = useTranslations(lang);
// the 404 has no page of its own in other languages: switch to that home
const switchPath = /\/404(\.html)?\/?$/.test(path) ? "/" : path;

// each language in its own name, so a reader can find theirs
const languageItems = [
  { locale: "ro", label: "Română" },
  { locale: "en", label: "English" },
  { locale: "ru", label: "Русский" },
] as const;
---

<nav class="langs" aria-label={t("language.label")}>
  <div class="frame-wide langs-inner">
    {
      languageItems.map((item) => (
        <a
          class:list={["lang", item.locale === lang && "is-current"]}
          href={getLocalizedPath(switchPath, item.locale)}
          lang={item.locale}
          aria-current={item.locale === lang ? "page" : undefined}>
          {item.label}
        </a>
      ))
    }
  </div>
</nav>

<header class="bar">
  <div class="frame-wide inner">
    <button
      type="button"
      class="tool"
      data-drawer-open
      aria-controls="rail-drawer"
      aria-expanded="false">
      <span class="bars" aria-hidden="true"><i></i><i></i><i></i></span>
      <span>{t("nav.menu")}</span>
    </button>

    <a class="brand" href={getLocalizedPath("/", lang)}>
      {/* the official seal, header cut */}
      <img class="brand-seal" src={sealHeaderUrl} width="84" height="70" alt="" decoding="async" />
      <span class="brand-name">
        <span>{t("main.logoLineOne")}</span>
        <span>{t("main.logoLineTwo")}</span>
        <span>{t("main.logoLineThree")}</span>
      </span>
    </a>

    <a class="tool" href={getLocalizedPath("/cautare", lang)}>
      <Icon name="search" size={28} />
      <span>{t("nav.searchShort")}</span>
    </a>
  </div>
</header>

<style>
  /* languages: a plain strip above the bar, scrolls away with the page */
  .langs {
    background: #1a3346;
    color: #fffdf8;
  }
  .langs-inner {
    display: flex;
    justify-content: flex-end;
    gap: var(--s-2);
  }
  .lang {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap-min);
    padding: 0 var(--s-3);
    color: inherit;
    font-size: var(--t-ui);
    text-decoration: none;
  }
  .lang:hover {
    text-decoration: underline;
  }
  .lang.is-current {
    font-weight: 500;
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 0.25em;
  }

  .bar {
    position: sticky;
    top: 0;
    z-index: 50;
    border-bottom: var(--rule) solid var(--seal-gold);
    background: var(--header);
    color: #1a3346;
  }
  .inner {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: var(--s-3);
    height: var(--nav-h);
  }

  /* Menu and Search: an icon and its word, always together */
  .tool {
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 2px;
    min-width: 64px;
    min-height: var(--tap);
    padding: 0;
    border: 0;
    background: transparent;
    color: inherit;
    font-family: inherit;
    font-size: 16px;
    font-weight: 500;
    line-height: 1.1;
    text-decoration: none;
    cursor: pointer;
  }
  .bars {
    display: grid;
    gap: 5px;
    width: 28px;
    padding: 4px 0;
  }
  .bars i {
    display: block;
    height: 3px;
    background: currentColor;
  }
  .tool:hover,
  .tool[aria-expanded="true"] {
    color: var(--seal-gold-text);
  }

  .brand {
    display: flex;
    align-items: center;
    justify-self: center;
    min-height: var(--tap);
    gap: var(--s-3);
    min-width: 0;
    color: inherit;
    text-decoration: none;
  }
  .brand-seal {
    flex-shrink: 0;
    width: 84px;
    height: auto;
  }
  .brand-name {
    display: grid;
    gap: 3px;
    font-family: var(--font-display);
    font-size: 17px;
    line-height: 1;
    font-weight: 500;
    letter-spacing: 0.03em;
    text-transform: uppercase;
  }

  .bar :focus-visible,
  .langs :focus-visible {
    outline: 3px solid var(--seal-gold-text);
    outline-offset: -3px;
  }

  @media (width < 40rem) {
    .inner {
      gap: var(--s-2);
    }
    .langs-inner {
      justify-content: space-between;
      gap: 0;
    }
    .brand {
      gap: var(--s-2);
    }
    .brand-seal {
      width: 56px;
    }
    .brand-name {
      font-size: 14px;
    }
  }
  @media (width < 380px) {
    .brand-seal {
      width: 46px;
    }
  }
</style>
