---
import type { Locale } from "@i18n";
import { getLocalizedPath, useTranslations } from "@i18n/utils";
import Icon from "@components/marks/Icon.astro";
import Seal from "@components/marks/Seal.astro";

type Props = {
  path: string;
  lang: Locale;
};

const { path, lang } = Astro.props;
const t = useTranslations(lang);
// the 404 has no page of its own in other languages: switch to that home
const switchPath = /\/404(\.html)?\/?$/.test(path) ? "/" : path;

const languageItems = [
  { locale: "ro", label: "RO" },
  { locale: "en", label: "EN" },
  { locale: "ru", label: "RU" },
] as const;
---

<header class="bar">
  <div class="frame-wide inner">
    <a class="brand" href={getLocalizedPath("/", lang)}>
      <Seal size={44} class="brand-seal" />
      <span class="brand-name">
        <span>{t("main.logoLineOne")}</span>
        <span>{t("main.logoLineTwo")}</span>
        <span>{t("main.logoLineThree")}</span>
      </span>
    </a>

    <div class="tools">
      <a class="find" href={getLocalizedPath("/cautare", lang)} aria-label={t("search.title")} title={t("search.title")}>
        <Icon name="search" size={20} />
      </a>

      {/* one joined strip of three square cells: neighbours share a hairline */}
      <nav class="langs" aria-label={t("language.label")}>
        {
          languageItems.map((item) => (
            <a
              class:list={["lang", item.locale === lang && "is-current"]}
              href={getLocalizedPath(switchPath, item.locale)}
              lang={item.locale}
              aria-label={`${item.label} · ${t(`language.${item.locale}`)}`}
              aria-current={item.locale === lang ? "page" : undefined}>
              {item.label}
            </a>
          ))
        }
      </nav>

      {
        /* The left rail is the only navigation. Below 1100px it lives in a
          drawer (RailDrawer); this is its one opener, marked with the four
          strata instead of a generic hamburger. */
      }
      <button
        type="button"
        class="opener"
        data-drawer-open
        aria-label={t("nav.openMenu")}
        aria-controls="rail-drawer"
        aria-expanded="false">
        <Icon name="menu" size={24} />
      </button>
    </div>
  </div>
</header>

<style>
  .bar {
    position: sticky;
    top: 0;
    z-index: 50;
    border-bottom: var(--rule) solid var(--ochre);
    background: var(--header);
  }
  .inner {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: var(--s-5);
    height: var(--nav-h);
  }

  .brand {
    display: flex;
    align-items: center;
    min-height: var(--tap);
    gap: var(--s-3);
    min-width: 0;
    color: var(--parchment);
    text-decoration: none;
  }
  .brand-seal {
    flex-shrink: 0;
  }
  .brand-name {
    display: grid;
    gap: 2px;
    /* Georgia, named first: ui-serif is New York on Apple — a third face */
    font-family: Georgia, "Times New Roman", serif;
    font-size: 13px;
    line-height: 1;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .tools {
    display: flex;
    grid-column: 3;
    align-items: center;
    justify-content: flex-end;
    gap: var(--s-4);
  }
  .langs {
    display: flex;
    align-items: center;
    color: color-mix(in srgb, var(--parchment) 82%, transparent);
    font-size: 13px;
    line-height: 16px;
    letter-spacing: 0.06em;
  }
  .lang {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: var(--s-6);
    min-width: var(--s-7);
    margin-left: calc(-1 * var(--rule));
    padding: 0 var(--s-2);
    border: var(--rule) solid color-mix(in srgb, var(--parchment) 22%, transparent);
    transition:
      color var(--dur-1) var(--ease-out),
      border-color var(--dur-1) var(--ease-out);
  }
  .lang:first-child {
    margin-left: 0;
  }
  .lang:hover {
    border-color: color-mix(in srgb, var(--parchment) 60%, transparent);
    color: var(--paper);
  }
  .lang.is-current {
    position: relative;
    z-index: 1;
    border-color: var(--signal);
    background: var(--signal);
    color: var(--ink);
  }

  .find {
    display: inline-flex;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    width: var(--s-6);
    height: var(--s-6);
    border: var(--rule) solid transparent;
    color: color-mix(in srgb, var(--parchment) 82%, transparent);
    transition:
      color var(--dur-1) var(--ease-out),
      border-color var(--dur-1) var(--ease-out);
  }
  .find:hover {
    border-color: color-mix(in srgb, var(--parchment) 60%, transparent);
    color: var(--paper);
  }

  .opener {
    display: none;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    width: var(--tap);
    height: var(--tap);
    border: var(--rule) solid color-mix(in srgb, var(--parchment) 22%, transparent);
    background: transparent;
    color: var(--parchment);
    cursor: pointer;
    transition:
      border-color var(--dur-1) var(--ease-out),
      background-color var(--dur-1) var(--ease-out);
  }
  .opener:hover {
    border-color: color-mix(in srgb, var(--parchment) 60%, transparent);
  }

  @media (width < 1100px) {
    .inner {
      gap: var(--s-3);
    }
    .tools {
      gap: var(--s-2);
    }
    /* on a phone the strip loses its frame: the current language is the
       one filled cell, the others are plain letters beside it */
    .lang {
      height: var(--tap);
      min-width: var(--tap-min);
      margin-left: 0;
      border-color: transparent;
    }
    .find {
      width: var(--tap);
      height: var(--tap);
    }
    .opener {
      display: inline-flex;
    }
  }
  @media (width < 40rem) {
    /* no room beside the name: search moves into the drawer */
    .find {
      display: none;
    }
    .brand-seal {
      width: 40px;
      height: 40px;
    }
    .brand-name {
      font-size: 11px;
    }
  }
  @media (width < 380px) {
    .brand {
      gap: var(--s-2);
    }
    .brand-name {
      letter-spacing: 0.04em;
    }
  }
</style>
