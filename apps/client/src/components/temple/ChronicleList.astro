---
// One entry per row: date, title, excerpt, lead photograph. Used by the
// cronică index, the year pages and the paginated pages — the list is written
// once, the way the templates are.
import type { PostItem } from "@data/posts";
import type { Locale } from "@i18n";
import { getLocalizedPath, useTranslations } from "@i18n/utils";

interface Props {
  posts: PostItem[];
  lang: Locale;
}

const { posts, lang } = Astro.props;
const t = useTranslations(lang);
---

{
  posts.length > 0 ? (
    <ol class="entries">
      {posts.map((post) => (
        <li class="entry">
          <a href={getLocalizedPath(`/posts/${post.slug}`, lang)}>
            {post.image ? (
              <img
                src={post.image.thumb}
                srcset={post.image.smallSrcset}
                sizes="(max-width: 680px) calc(100vw - 32px), 176px"
                width="480"
                height="360"
                alt={post.image.alt}
                loading="lazy"
                decoding="async"
              />
            ) : (
              <span class="no-image" aria-hidden="true" />
            )}
            <div class="entry-text">
              <time datetime={post.isoDate}>{post.date}</time>
              <h2>{post.title}</h2>
              {post.excerpt && <p>{post.excerpt}</p>}
              {post.archiveImages > 1 && <p class="meta">{`${post.archiveImages} ${t("gallery.count")}`}</p>}
            </div>
          </a>
        </li>
      ))}
    </ol>
  ) : (
    <p class="empty">{t("home.noPosts")}</p>
  )
}

<style>
  .entries {
    list-style: none;
    margin: 0;
    padding: 0;
    /* no rule of its own on top: the year run above closes on one */
  }
  .entry a {
    display: grid;
    grid-template-columns: 176px minmax(0, 1fr);
    gap: var(--s-6);
    align-items: start;
    padding: var(--s-6) 0;
    border-bottom: var(--rule) solid var(--line);
    text-decoration: none;
    color: inherit;
  }
  .entry:first-child a {
    padding-top: var(--s-2);
  }
  /* hover marks the title, not the row: no washed band across the list */
  .entry h2 {
    text-decoration: underline;
    text-decoration-thickness: var(--rule);
    text-decoration-color: transparent;
    text-underline-offset: 0.2em;
    transition: text-decoration-color var(--dur-1) var(--ease-out);
  }
  .entry a:hover h2 {
    text-decoration-color: var(--seal-gold);
  }
  .entry a:focus-visible {
    outline-offset: var(--s-1);
  }
  .entry img,
  .no-image {
    display: block;
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    background: var(--seal-deep);
  }
  .entry time {
    display: block;
    font-size: var(--t-meta);
    line-height: 1.4;
    color: var(--ochre);
    font-variant-numeric: lining-nums tabular-nums;
  }
  .entry h2 {
    font-size: clamp(19px, 1.7vw, 23px);
    font-weight: 400;
    line-height: 1.3;
    margin: var(--s-2) 0 0;
    text-wrap: balance;
  }
  .entry p {
    margin: var(--s-2) 0 0;
    color: var(--seal-mist);
    font-size: 16px;
    line-height: 1.6;
    max-width: var(--measure);
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 3;
    line-clamp: 3;
    overflow: hidden;
  }
  .entry .meta {
    display: block;
    margin-top: var(--s-3);
    font-size: var(--t-meta);
    color: var(--seal-mist);
  }
  .empty {
    color: var(--seal-mist);
    font-style: italic;
  }

  @media (max-width: 1100px) {
    .entry a {
      gap: var(--s-5);
    }
  }
  @media (max-width: 680px) {
    .entry a {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--s-4);
    }
  }
</style>
