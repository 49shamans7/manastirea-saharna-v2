---
// One entry per row: date, title, excerpt, lead photograph. Used by the
// cronică index, the year pages and the paginated pages — the list is written
// once, the way the templates are.
import type { PostItem } from "@data/posts";
import type { Locale } from "@i18n";
import { getLocalizedPath, useTranslations } from "@i18n/utils";

interface Props {
  posts: PostItem[];
  lang: Locale;
}

const { posts, lang } = Astro.props;
const t = useTranslations(lang);
---

{
  posts.length > 0 ? (
    <ol class="entries">
      {posts.map((post) => (
        <li class="entry">
          <a href={getLocalizedPath(`/posts/${post.slug}`, lang)}>
            {post.image ? (
              <img
                src={post.image.thumb}
                srcset={post.image.smallSrcset}
                sizes="(max-width: 860px) calc(100vw - 32px), 560px"
                width="480"
                height="360"
                alt={post.image.alt}
                loading="lazy"
                decoding="async"
              />
            ) : (
              <span class="no-image" aria-hidden="true" />
            )}
            <div class="entry-text">
              <time datetime={post.isoDate}>{post.date}</time>
              <h2>{post.title}</h2>
              {post.excerpt && <p>{post.excerpt}</p>}
              {post.archiveImages > 1 && <p class="meta">{`${post.archiveImages} ${t("gallery.count")}`}</p>}
            </div>
          </a>
        </li>
      ))}
    </ol>
  ) : (
    <p class="empty">{t("home.noPosts")}</p>
  )
}

<style>
  .entries {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 24rem), 1fr));
    gap: var(--s-6) var(--s-5);
    list-style: none;
    margin: var(--s-5) 0 0;
    padding: 0;
  }
  .entry a {
    display: grid;
    gap: var(--s-3);
    align-content: start;
    height: 100%;
    text-decoration: none;
    color: inherit;
  }
  .entry a:focus-visible {
    outline-offset: var(--s-1);
  }
  /* hover marks the title, not the row: no washed band across the list */
  .entry h2 {
    text-decoration: underline;
    text-decoration-thickness: var(--rule);
    text-decoration-color: transparent;
    text-underline-offset: 0.2em;
    transition: text-decoration-color var(--dur-1) var(--ease-out);
  }
  .entry a:hover h2 {
    text-decoration-color: var(--seal-gold);
  }
  .entry img,
  .no-image {
    display: block;
    width: 100%;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    background: #efe5cc;
    border: var(--rule) solid var(--line);
    box-sizing: border-box;
  }
  .entry time {
    display: block;
    font-size: var(--t-meta);
    line-height: 1.4;
    letter-spacing: 0.06em;
    color: var(--seal-gold-text);
    font-variant-numeric: lining-nums tabular-nums;
  }
  .entry h2 {
    font-size: 23px;
    font-weight: 700;
    line-height: 1.3;
    margin: var(--s-1) 0 0;
    text-wrap: balance;
  }
  .entry p {
    margin: var(--s-2) 0 0;
    color: #1a3346;
    font-size: 18px;
    line-height: 1.5;
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 3;
    line-clamp: 3;
    overflow: hidden;
  }
  .entry .meta {
    display: block;
    margin-top: var(--s-3);
    font-size: var(--t-meta);
    color: var(--seal-mist);
  }
  .empty {
    color: var(--seal-mist);
    font-style: italic;
  }
</style>
