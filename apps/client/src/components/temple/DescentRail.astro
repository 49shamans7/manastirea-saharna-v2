---
// LEFT RAIL — the descent index. Where you are in the strata.
// Structural, permanent, never changes. It is also the second way into the
// chambers: if the shrine door were the only route, most visitors would never
// reach the monastery's substance. ARCHITECTURE.md § The hinge.
import type { Locale } from "@i18n";
import { getLocalizedPath, useTranslations } from "@i18n/utils";
import { zones, type ZoneId } from "@temple/zones";

interface Props {
  lang: Locale;
  /** Zone the current page belongs to, or null on the descent itself. */
  current?: ZoneId | null;
  /** Canonical path of the current page, for marking the exact chamber. */
  path?: string;
}

const { lang, current = null, path = "" } = Astro.props;
const t = useTranslations(lang);
const clean = path.replace(/\/$/, "");
// the exact chamber is "here"; a page inside it (/posts/<slug>) lights it too
const isHere = (href: string) => clean.endsWith(href);
const isUnder = (href: string) => isHere(href) || clean.includes(`${href}/`);
---

<nav class="rail-left" aria-label={t("zone.descentIndex")}>
  <ol class="strata">
    {
      zones.map((zone) => (
        <li class:list={["stratum-entry", `is-${zone.id}`, current === zone.id && "is-current"]}>
          <a class="stratum-head" href={`${getLocalizedPath("/", lang)}#zona-${zone.id}`}>
            <span class="zone-name">{t(zone.nameKey)}</span>
          </a>
          <ul class="chambers">
            {zone.pages.map((page) => (
              <li>
                <a
                  class:list={["chamber-link", isUnder(page.href) && "is-here"]}
                  href={getLocalizedPath(page.href, lang)}
                  aria-current={isHere(page.href) ? "page" : undefined}>
                  {t(page.labelKey)}
                </a>
              </li>
            ))}
          </ul>
        </li>
      ))
    }
  </ol>
</nav>

<style>
  .rail-left {
    position: sticky;
    top: var(--nav-h, var(--s-10));
    align-self: start;
    max-height: calc(100dvh - var(--nav-h, 80px));
    overflow-y: auto;
    padding: var(--page-top) 0 var(--s-8);
    scrollbar-width: none;
  }
  .rail-left::-webkit-scrollbar {
    display: none;
  }

  .strata,
  .chambers {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  /* The rail is a shaft: one continuous hairline down the left edge, cut
     by a square tick at each stratum. The stratum you are in draws its
     length of shaft at emphasis weight, in ochre. */
  .stratum-entry {
    position: relative;
    padding: 0 0 var(--s-5) var(--s-5);
  }
  .stratum-entry::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: var(--rule);
    background: var(--line);
  }
  .stratum-entry:last-child::before {
    bottom: auto;
    height: var(--s-5);
  }
  .stratum-entry.is-current::before {
    width: var(--rule-2);
    background: var(--line-strong);
  }
  /* 8px square tick, centred on the 1px line's left edge, on the head's
     cap height */
  .stratum-entry::after {
    content: "";
    position: absolute;
    left: calc(var(--s-1) * -1 + 1px);
    top: var(--s-1);
    width: var(--s-2);
    height: var(--s-2);
    background: var(--zone-tick, currentColor);
  }
  .stratum-entry.is-current::after {
    background: var(--ochre);
  }

  .is-rock {
    --zone-tick: var(--rock-lilac);
  }
  .is-green {
    --zone-tick: var(--green-sage);
  }
  .is-gold {
    --zone-tick: var(--gold);
  }
  .is-river {
    --zone-tick: var(--river);
  }

  .stratum-head {
    display: flex;
    align-items: center;
    gap: var(--s-2);
    min-height: var(--s-4);
    text-decoration: none;
    color: inherit;
    font-size: var(--t-kicker);
    line-height: var(--s-4);
    letter-spacing: var(--track-kicker);
    text-transform: uppercase;
    opacity: 0.78;
    transition: opacity var(--dur-1) var(--ease-out);
  }
  .stratum-head:hover {
    opacity: 1;
  }
  .is-current .stratum-head {
    opacity: 1;
  }

  .chambers {
    margin-top: var(--s-2);
    display: grid;
  }
  .chamber-link {
    display: flex;
    align-items: center;
    min-height: var(--s-6);
    padding: var(--s-1) 0;
    font-size: var(--t-ui);
    line-height: 1.3;
    text-decoration: none;
    color: color-mix(in srgb, currentColor 70%, transparent);
    transition: color var(--dur-1) var(--ease-out);
  }
  .chamber-link:hover {
    color: inherit;
  }
  .chamber-link.is-here {
    color: var(--here, var(--ochre));
  }

  /* below the frame width the rail is not a rail — the drawer carries it */
  @media (max-width: 1100px) {
    .rail-left {
      display: none;
    }
  }
</style>
