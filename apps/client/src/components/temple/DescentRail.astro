---
// LEFT RAIL — the descent index as a depth gauge. Where you are in the strata.
// From the chamber prototype (design/prototypes/templates/chamber.html
// .rail-l): one field wide, a marker per stratum, the stratum you are in
// filled, and its name set vertically under them. The markers are the seal's
// gold squares (SOLID: nothing is rounded).
//
// It is also the second way into the chambers (ARCHITECTURE.md § The hinge):
// the zone's name is the drawer's opener, so the full index — every zone and
// every chamber — is one tap from the rail at every width.
import type { Locale } from "@i18n";
import { getLocalizedPath, useTranslations } from "@i18n/utils";
import { zones, zoneById, type ZoneId } from "@temple/zones";

interface Props {
  lang: Locale;
  /** Zone the current page belongs to, or null on the descent itself. */
  current?: ZoneId | null;
  /** Canonical path of the current page (kept for the API; the gauge marks zones). */
  path?: string;
}

const { lang, current = null } = Astro.props;
const t = useTranslations(lang);
const here = current ? zoneById[current] : null;
---

<nav class="rail-left" aria-label={t("zone.descentIndex")}>
  <ol class="gauge">
    {
      zones.map((zone) => (
        <li>
          <a
            class:list={["marker", current === zone.id && "is-current"]}
            href={`${getLocalizedPath("/", lang)}#zona-${zone.id}`}
            title={`${zone.numeral} · ${t(zone.nameKey)}`}
            aria-current={current === zone.id ? "location" : undefined}>
            <span class="square" aria-hidden="true" />
            <span class="sr-only">{`${zone.numeral} · ${t(zone.nameKey)}`}</span>
          </a>
        </li>
      ))
    }
  </ol>
  {
    here && (
      <button
        type="button"
        class="depth"
        data-drawer-open
        aria-controls="rail-drawer"
        aria-expanded="false"
        aria-haspopup="dialog">
        <span class="numeral">{here.numeral}</span>
        <span class="depth-name">{t(here.nameKey)}</span>
      </button>
    )
  }
</nav>

<style>
  .rail-left {
    position: sticky;
    top: var(--nav-h, 80px);
    align-self: start;
    box-sizing: border-box;
    height: calc(100dvh - var(--nav-h, 80px));
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--s-5);
    padding: var(--s-5) 0;
    border-right: var(--rule) solid var(--line);
    background: #ffffff;
  }

  .gauge {
    display: grid;
    gap: var(--s-1);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  /* a thumb's target round an 11px mark */
  .marker {
    display: grid;
    place-items: center;
    width: var(--tap-min);
    height: var(--tap-min);
    color: inherit;
  }
  .square {
    width: 11px;
    height: 11px;
    box-sizing: border-box;
    border: var(--rule) solid var(--seal-gold);
    background: #ffffff;
    transition:
      background-color var(--dur-1) var(--ease-out),
      border-color var(--dur-1) var(--ease-out);
  }
  .marker:hover .square {
    border-color: var(--seal-gold-text);
  }
  /* the stratum you are in: filled, in the gold that holds 5.8:1 */
  .marker.is-current .square {
    border-color: var(--seal-gold-text);
    background: var(--seal-gold-text);
  }

  /* the zone's name, set down the rail; it opens the full index */
  .depth {
    display: flex;
    align-items: center;
    gap: var(--s-3);
    min-width: var(--tap-min);
    padding: var(--s-3) 0;
    border: 0;
    background: transparent;
    color: var(--seal-gold-text);
    font: inherit;
    font-size: 11px;
    line-height: 1;
    letter-spacing: 0.42em;
    text-transform: uppercase;
    writing-mode: vertical-rl;
    cursor: pointer;
    transition: color var(--dur-1) var(--ease-out);
  }
  .depth:hover {
    color: var(--seal-paper);
  }
  .numeral {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 13px;
    letter-spacing: 0.1em;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }

  /* a phone: the gauge lies down — a strip above the page, markers left,
     the zone's name beside them */
  @media (max-width: 1100px) {
    .rail-left {
      position: static;
      height: auto;
      flex-direction: row;
      justify-content: flex-start;
      gap: var(--s-3);
      padding: 0 var(--frame-pad);
      padding-left: calc(var(--frame-pad) - 16px);
      border-right: 0;
      border-bottom: var(--rule) solid var(--line);
    }
    .gauge {
      display: flex;
      gap: 0;
    }
    .depth {
      writing-mode: horizontal-tb;
      min-height: var(--tap-min);
      padding: 0;
    }
  }
</style>
