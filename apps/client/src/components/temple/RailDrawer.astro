---
// THE DESCENT INDEX, IN THE HAND — every zone and every chamber. Hidden until
// asked for, at every width (owner: the menu stays closed until toggled);
// slides in from the left, over the page, and back out. The left rail beside
// a page is only a depth gauge; this is the full index it opens.
// Laid out as the descent: four strata, numbered I–IV, a gold square on one
// hairline running down through them, each zone's chambers in hairline rows
// under it. The seal's white field, navy ink, read-gold.
// ARCHITECTURE.md § The frame · § The hinge.
//
// Behaviour (vanilla, no library):
//   open   — the header's strata mark, or the zone name on the depth gauge
//   close  — scrim tap, Esc, any link, the close button, a left swipe
//   while open — body scroll locked, the page behind is `inert`, focus is
//   trapped in the drawer and handed back to whichever button opened it.
import type { Locale } from "@i18n";
import { getLocalizedPath, useTranslations } from "@i18n/utils";
import { stripBasePath } from "@utils/paths";
import { zones, zoneOfPath } from "@temple/zones";
import Icon from "@components/marks/Icon.astro";

interface Props {
  lang: Locale;
  path: string;
}

const { lang, path } = Astro.props;
const t = useTranslations(lang);
// the 404 has no page of its own in other languages: switch to that home
const switchPath = /\/404(\.html)?\/?$/.test(path) ? "/" : path;

// canonical path, without base, locale or trailing slash: "/slujbe", "/"
const canonical =
  stripBasePath(path)
    .replace(/^\/(en|ru)(?=\/|$)/, "")
    .replace(/\/$/, "") || "/";
const currentZone = zoneOfPath(canonical);
const isHere = (href: string) => canonical === href;
const isUnder = (href: string) => canonical === href || canonical.startsWith(`${href}/`);

const languageItems = [
  { locale: "ro", label: "RO" },
  { locale: "en", label: "EN" },
  { locale: "ru", label: "RU" },
] as const;
---

<div class="drawer-scrim" data-drawer-scrim aria-hidden="true"></div>

<div
  id="rail-drawer"
  class="drawer ground-white"
  role="dialog"
  aria-modal="true"
  aria-label={t("zone.descentIndex")}
  data-drawer
  inert>
  <div class="drawer-head">
    <button class="drawer-close" type="button" data-drawer-close aria-label={t("nav.closeMenu")}>
      <Icon name="close" />
    </button>
    <a class="drawer-home" href={getLocalizedPath("/", lang)}>{t("main.title")}</a>
  </div>

  <nav class="drawer-nav" aria-label={t("zone.descentIndex")}>
    <ol class="drawer-strata">
      {
        zones.map((zone, index) => (
          <li
            class:list={["zone-group", currentZone === zone.id && "is-current"]}
            style={`--i:${index}`}>
            <a
              class="zone-head"
              href={`${getLocalizedPath("/", lang)}#zona-${zone.id}`}
              aria-current={currentZone === zone.id ? "location" : undefined}>
              <span class="zone-mark" aria-hidden="true" />
              <span class="zone-numeral">{zone.numeral}</span>
              <span class="zone-name">{t(zone.nameKey)}</span>
            </a>
            <ul class="zone-chambers">
              {zone.pages.map((page) => (
                <li>
                  <a
                    class:list={["drawer-link", isUnder(page.href) && "is-here"]}
                    href={getLocalizedPath(page.href, lang)}
                    aria-current={isHere(page.href) ? "page" : undefined}>
                    {t(page.labelKey)}
                  </a>
                </li>
              ))}
            </ul>
          </li>
        ))
      }
    </ol>
  </nav>

  <nav class="drawer-langs" aria-label={t("language.label")}>
    {
      languageItems.map((item) => (
        <a
          class:list={["drawer-lang", item.locale === lang && "is-current"]}
          href={getLocalizedPath(switchPath, item.locale)}
          lang={item.locale}
          aria-label={`${item.label} · ${t(`language.${item.locale}`)}`}
          aria-current={item.locale === lang ? "page" : undefined}>
          {item.label}
        </a>
      ))
    }
    <a class="drawer-find" href={getLocalizedPath("/cautare", lang)}>
      <Icon name="search" size={18} />
      <span>{t("search.title")}</span>
    </a>
  </nav>
</div>

<script>
  const drawer = document.querySelector<HTMLElement>("[data-drawer]");
  const scrim = document.querySelector<HTMLElement>("[data-drawer-scrim]");
  const openers = Array.from(document.querySelectorAll<HTMLButtonElement>("[data-drawer-open]"));

  if (drawer && scrim) {
    let opener: HTMLElement | null = null;
    let inerted: Element[] = [];

    const focusables = () =>
      Array.from(
        drawer.querySelectorAll<HTMLElement>('a[href], button:not([disabled]), [tabindex]:not([tabindex="-1"])'),
      ).filter((el) => el.offsetParent !== null);

    const setExpanded = (value: boolean) =>
      openers.forEach((button) => button.setAttribute("aria-expanded", String(value)));

    const lockScroll = (lock: boolean) => {
      const root = document.documentElement;
      if (lock) {
        // compensate for a disappearing scrollbar so nothing shifts sideways
        const gap = window.innerWidth - root.clientWidth;
        root.style.setProperty("--scroll-gap", `${gap}px`);
        root.classList.add("drawer-locked");
      } else {
        root.classList.remove("drawer-locked");
        root.style.removeProperty("--scroll-gap");
      }
    };

    const open = (from: HTMLElement | null) => {
      if (drawer.classList.contains("is-open")) return;
      opener = from;
      drawer.removeAttribute("inert");
      // everything else on the page goes inert: no focus, no clicks, no AT
      inerted = Array.from(document.body.children).filter(
        (el) => el !== drawer && el !== scrim && !el.hasAttribute("inert") && el.tagName !== "SCRIPT",
      );
      inerted.forEach((el) => el.setAttribute("inert", ""));
      drawer.classList.add("is-open");
      scrim.classList.add("is-open");
      setExpanded(true);
      lockScroll(true);
      // focus the current chamber if there is one, else the close button
      const here = drawer.querySelector<HTMLElement>(".drawer-link.is-here");
      (here ?? drawer.querySelector<HTMLElement>("[data-drawer-close]"))?.focus({ preventScroll: true });
    };

    const close = (restoreFocus = true) => {
      if (!drawer.classList.contains("is-open")) return;
      drawer.classList.remove("is-open");
      scrim.classList.remove("is-open");
      drawer.style.removeProperty("transform");
      drawer.setAttribute("inert", "");
      inerted.forEach((el) => el.removeAttribute("inert"));
      inerted = [];
      setExpanded(false);
      lockScroll(false);
      if (restoreFocus) opener?.focus({ preventScroll: true });
    };

    openers.forEach((button) => button.addEventListener("click", () => open(button)));
    scrim.addEventListener("click", () => close());
    drawer.querySelector("[data-drawer-close]")?.addEventListener("click", () => close());

    // any link closes it — the page it leads to is the answer
    drawer
      .querySelectorAll<HTMLAnchorElement>("a[href]")
      .forEach((link) => link.addEventListener("click", () => close(false)));

    // Esc, and a focus trap for Tab / Shift+Tab
    document.addEventListener("keydown", (event) => {
      if (!drawer.classList.contains("is-open")) return;
      if (event.key === "Escape") {
        event.preventDefault();
        close();
        return;
      }
      if (event.key !== "Tab") return;
      const items = focusables();
      if (!items.length) return;
      const first = items[0];
      const last = items[items.length - 1];
      if (!first || !last) return;
      if (event.shiftKey && document.activeElement === first) {
        event.preventDefault();
        last.focus();
      } else if (!event.shiftKey && document.activeElement === last) {
        event.preventDefault();
        first.focus();
      }
    });

    // a left swipe sends it back. The drawer follows the finger; past 60px it
    // goes, short of that it springs home.
    let startX = 0;
    let startY = 0;
    let dx = 0;
    let tracking = false;
    let horizontal: boolean | null = null;

    drawer.addEventListener("pointerdown", (event) => {
      if (event.pointerType === "mouse") return;
      tracking = true;
      horizontal = null;
      startX = event.clientX;
      startY = event.clientY;
      dx = 0;
    });
    drawer.addEventListener("pointermove", (event) => {
      if (!tracking) return;
      const mx = event.clientX - startX;
      const my = event.clientY - startY;
      if (horizontal === null && Math.abs(mx) + Math.abs(my) > 8) horizontal = Math.abs(mx) > Math.abs(my);
      if (!horizontal) return;
      dx = Math.min(0, mx);
      drawer.classList.add("is-dragging");
      drawer.style.transform = `translateX(${dx}px)`;
    });
    const release = () => {
      if (!tracking) return;
      tracking = false;
      drawer.classList.remove("is-dragging");
      drawer.style.removeProperty("transform");
      if (horizontal && dx < -60) close();
    };
    drawer.addEventListener("pointerup", release);
    drawer.addEventListener("pointercancel", release);

  }
</script>

<style>
  /* the drawer at every width: the index, unseen until it is asked for */
  .drawer-scrim {
    position: fixed;
    inset: 0;
    z-index: 90;
    background: var(--scrim);
    opacity: 0;
    pointer-events: none;
    transition: opacity var(--dur-2) var(--ease-in);
  }
  .drawer-scrim.is-open {
    opacity: 1;
    pointer-events: auto;
    transition: opacity var(--dur-3) var(--ease-out);
  }

  .drawer {
    display: flex;
    flex-direction: column;
    position: fixed;
    top: 0;
    left: 0;
    z-index: 91;
    width: min(calc(100vw - var(--s-8)), 384px);
    height: 100vh;
    height: 100dvh;
    padding: env(safe-area-inset-top) 0 env(safe-area-inset-bottom) env(safe-area-inset-left);
    box-sizing: border-box;
    overflow-y: auto;
    overscroll-behavior: contain;
    touch-action: pan-y;
    /* the seal's white field; one hard edge in the seal's gold */
    background: #ffffff;
    color: var(--seal-paper);
    border-right: var(--rule-2) solid var(--seal-gold);
    font-family: Georgia, "Times New Roman", serif;
    transform: translateX(-100%);
    visibility: hidden;
    transition:
      transform var(--dur-2) var(--ease-in),
      visibility 0s linear var(--dur-2);
    will-change: transform;
  }
  .drawer.is-open {
    transform: translateX(0);
    visibility: visible;
    transition:
      transform var(--dur-3) var(--ease-out),
      visibility 0s;
  }
  .drawer.is-dragging {
    transition: none;
  }

  /* the head mirrors the bar: the close sits where the opener sat */
  .drawer-head {
    display: flex;
    align-items: center;
    gap: var(--s-2);
    min-height: var(--nav-h, 64px);
    padding: 0 var(--s-4) 0 calc(var(--frame-pad) - 12px);
    border-bottom: var(--rule) solid var(--line);
  }
  .drawer-home {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap);
    color: inherit;
    text-decoration: none;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 16px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .drawer-close {
    display: grid;
    place-items: center;
    flex: 0 0 var(--tap);
    width: var(--tap);
    height: var(--tap);
    border: 0;
    background: transparent;
    color: inherit;
    cursor: pointer;
    transition: color var(--dur-1) var(--ease-out);
  }
  .drawer-close:hover {
    color: var(--seal-gold-text);
  }

  /* ── the strata ── */
  .drawer-nav {
    flex: 1 0 auto;
    padding: var(--s-6) var(--s-5) var(--s-5);
  }
  .drawer-strata,
  .zone-chambers {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .zone-group {
    position: relative;
    padding-bottom: var(--s-5);
  }
  /* one hairline runs down through the four markers: the shaft */
  .zone-group::before {
    content: "";
    position: absolute;
    left: 5px;
    top: 24px;
    bottom: -24px;
    width: var(--rule);
    background: var(--line);
  }
  .zone-group:last-child::before {
    display: none;
  }

  .zone-head {
    position: relative;
    display: flex;
    align-items: center;
    gap: var(--s-3);
    min-height: var(--tap);
    color: var(--seal-gold-text);
    text-decoration: none;
    font-size: 11px;
    letter-spacing: 0.42em;
    text-transform: uppercase;
  }
  /* uniform gold squares; the stratum you are in is filled */
  .zone-mark {
    position: relative;
    z-index: 1;
    flex: 0 0 11px;
    height: 11px;
    box-sizing: border-box;
    border: var(--rule) solid var(--seal-gold);
    background: #ffffff;
  }
  .is-current .zone-mark {
    border-color: var(--seal-gold-text);
    background: var(--seal-gold-text);
  }
  .zone-numeral {
    min-width: 2.2em;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 14px;
    letter-spacing: 0.08em;
  }
  .zone-name {
    flex: 1;
  }
  .zone-head:hover .zone-name {
    text-decoration: underline;
    text-decoration-thickness: var(--rule);
    text-underline-offset: 0.3em;
  }

  /* each zone's chambers: hairline rows, set in from the shaft */
  .zone-chambers {
    margin-left: calc(11px + var(--s-3));
    border-top: var(--rule) solid var(--line);
  }
  .drawer-link {
    position: relative;
    display: flex;
    align-items: center;
    min-height: var(--tap);
    padding: var(--s-2) var(--s-2) var(--s-2) 0;
    box-sizing: border-box;
    border-bottom: var(--rule) solid var(--line);
    color: var(--seal-paper);
    text-decoration: none;
    font-size: 17px;
    line-height: 1.3;
    transition: color var(--dur-1) var(--ease-out);
  }
  .drawer-link:hover {
    color: var(--seal-gold-text);
  }
  .drawer-link.is-here {
    color: var(--seal-gold-text);
  }
  /* the chamber you are in: a short gold rule hung off the row */
  .drawer-link.is-here::after {
    content: "";
    flex: 0 0 24px;
    height: 2px;
    margin-left: auto;
    background: var(--seal-gold);
  }
  .drawer-link:active,
  .zone-head:active {
    background: var(--seal-deep);
  }

  /* ── languages and search, closing the drawer ── */
  .drawer-langs {
    display: flex;
    align-items: center;
    padding: var(--s-4) var(--s-5) var(--s-5);
    border-top: var(--rule) solid var(--line);
  }
  .drawer-lang {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: var(--tap);
    min-height: var(--tap);
    box-sizing: border-box;
    padding-left: 0.2em;
    border: var(--rule) solid var(--line);
    color: var(--seal-mist);
    text-decoration: none;
    font-size: 12px;
    line-height: 1;
    letter-spacing: 0.2em;
  }
  .drawer-lang + .drawer-lang {
    margin-left: calc(var(--rule) * -1);
  }
  .drawer-lang:hover {
    position: relative;
    z-index: 2;
    border-color: var(--seal-paper);
    color: var(--seal-paper);
  }
  .drawer-lang.is-current {
    position: relative;
    z-index: 1;
    border-color: var(--seal-gold-text);
    color: var(--seal-gold-text);
  }
  .drawer-find {
    display: inline-flex;
    align-items: center;
    gap: var(--s-2);
    min-height: var(--tap);
    margin-left: auto;
    padding: 0 0 0 var(--s-4);
    color: var(--seal-paper);
    font-size: 11px;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    text-decoration: none;
  }
  .drawer-find:hover {
    color: var(--seal-gold-text);
  }

  .drawer :focus-visible {
    outline: var(--rule-2) solid var(--seal-gold-text);
    outline-offset: calc(var(--rule-2) * -1);
  }

  /* strata are set in place one after another — a short hard slide */
  .drawer.is-open .zone-group,
  .drawer.is-open .drawer-langs {
    animation: drawer-rise var(--dur-2) var(--ease-out) both;
    animation-delay: calc(var(--dur-1) + var(--i, 4) * 30ms);
  }
  @keyframes drawer-rise {
    from {
      opacity: 0;
      transform: translateX(calc(var(--s-2) * -1));
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .drawer,
    .drawer.is-open,
    .drawer-scrim,
    .drawer-scrim.is-open {
      transition: none !important;
    }
    .drawer.is-open .zone-group,
    .drawer.is-open .drawer-langs {
      animation: none !important;
    }
  }
</style>

<style is:global>
  /* scroll lock while the drawer is open — no sideways jump */
  html.drawer-locked,
  html.drawer-locked body {
    overflow: hidden;
  }
  html.drawer-locked body {
    padding-right: var(--scroll-gap, 0px);
  }
</style>
