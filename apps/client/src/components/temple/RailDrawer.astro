---
// THE LEFT RAIL, ON A PHONE — the same descent index, carried in the hand.
// Above 1100px the rail is a permanent column (DescentRail.astro). Below it
// there is no room for a column, so the index slides in from the left, over
// the strata, and slides back out. Same four zones, same order, same ticks:
// it is the rail, not a menu. ARCHITECTURE.md § The frame · § The hinge.
//
// Behaviour (vanilla, no library):
//   open   — the header toggle (the four-strata mark)
//   close  — scrim tap, Esc, any link, the close button, a left swipe
//   while open — body scroll locked, the page behind is `inert`, focus is
//   trapped in the drawer and handed back to whichever button opened it.
import type { Locale } from "@i18n";
import { getLocalizedPath, useTranslations } from "@i18n/utils";
import { stripBasePath } from "@utils/paths";
import { zones, zoneOfPath } from "@temple/zones";
import Icon from "@components/marks/Icon.astro";

interface Props {
  lang: Locale;
  path: string;
}

const { lang, path } = Astro.props;
const t = useTranslations(lang);
// the 404 has no page of its own in other languages: switch to that home
const switchPath = /\/404(\.html)?\/?$/.test(path) ? "/" : path;

// canonical path, without base, locale or trailing slash: "/slujbe", "/"
const canonical =
  stripBasePath(path)
    .replace(/^\/(en|ru)(?=\/|$)/, "")
    .replace(/\/$/, "") || "/";
const currentZone = zoneOfPath(canonical);
const isHere = (href: string) => canonical === href;
const isUnder = (href: string) => canonical === href || canonical.startsWith(`${href}/`);

// The pilgrim's row: what a visitor on the road needs, one tap away and
// always open, above the descent (whose zones fold).
const pilgrimLinks = [
  { key: "zone.slujbe", href: "/slujbe" },
  { key: "zone.directions", href: "/cum-de-ajuns" },
  { key: "nav.contact", href: "/contact" },
  { key: "zone.cazare", href: "/cazare" },
  { key: "nav.donations", href: "/donations" },
  { key: "nav.pomelnic", href: "/pomelnic" },
] as const;

const languageItems = [
  { locale: "ro", label: "RO" },
  { locale: "en", label: "EN" },
  { locale: "ru", label: "RU" },
] as const;
---

<div class="drawer-scrim" data-drawer-scrim aria-hidden="true"></div>

<div
  id="rail-drawer"
  class="drawer"
  role="dialog"
  aria-modal="true"
  aria-label={t("zone.descentIndex")}
  data-drawer
  inert>
  <div class="drawer-head">
    <a class="drawer-home" href={getLocalizedPath("/", lang)}>{t("main.title")}</a>
    <button class="drawer-close" type="button" data-drawer-close aria-label={t("nav.closeMenu")}>
      <Icon name="close" />
    </button>
  </div>

  <nav class="drawer-nav" aria-label={t("zone.descentIndex")}>
    <ul class="drawer-pilgrim">
      {
        pilgrimLinks.map((link) => (
          <li>
            <a
              class:list={["pilgrim-link", isUnder(link.href) && "is-here"]}
              href={getLocalizedPath(link.href, lang)}
              aria-current={isHere(link.href) ? "page" : undefined}>
              {t(link.key)}
            </a>
          </li>
        ))
      }
    </ul>
    <ol class="drawer-strata">
      {
        zones.map((zone, index) => {
          // the zone you are in is open; on the descent itself, all are
          const open = currentZone === null || currentZone === zone.id;
          return (
            <li
              class:list={["zone-group", `is-${zone.id}`, currentZone === zone.id && "is-current"]}
              style={`--i:${index}`}>
              <div class="zone-row">
                <a class="zone-head" href={`${getLocalizedPath("/", lang)}#zona-${zone.id}`}>
                  <span class="zone-name">{t(zone.nameKey)}</span>
                </a>
                <button
                  class="zone-toggle"
                  type="button"
                  aria-expanded={open ? "true" : "false"}
                  aria-controls={`drawer-zone-${zone.id}`}
                  aria-label={t(zone.nameKey)}>
                  <span aria-hidden="true" />
                </button>
              </div>
              <ul class="zone-chambers" id={`drawer-zone-${zone.id}`} hidden={!open}>
                {zone.pages.map((page) => (
                  <li>
                    <a
                      class:list={["drawer-link", isUnder(page.href) && "is-here"]}
                      href={getLocalizedPath(page.href, lang)}
                      aria-current={isHere(page.href) ? "page" : undefined}>
                      {t(page.labelKey)}
                    </a>
                  </li>
                ))}
              </ul>
            </li>
          );
        })
      }
    </ol>
  </nav>

  <nav class="drawer-langs" aria-label={t("language.label")}>
    {
      languageItems.map((item) => (
        <a
          class:list={["drawer-lang", item.locale === lang && "is-current"]}
          href={getLocalizedPath(switchPath, item.locale)}
          lang={item.locale}
          aria-label={`${item.label} · ${t(`language.${item.locale}`)}`}
          aria-current={item.locale === lang ? "page" : undefined}>
          {item.label}
        </a>
      ))
    }
    <a class="drawer-find" href={getLocalizedPath("/cautare", lang)}>
      <Icon name="search" size={18} />
      <span>{t("search.title")}</span>
    </a>
  </nav>
</div>

<script>
  const drawer = document.querySelector<HTMLElement>("[data-drawer]");
  const scrim = document.querySelector<HTMLElement>("[data-drawer-scrim]");
  const openers = Array.from(document.querySelectorAll<HTMLButtonElement>("[data-drawer-open]"));
  const desktop = window.matchMedia("(min-width: 1101px)");

  if (drawer && scrim) {
    let opener: HTMLElement | null = null;
    let inerted: Element[] = [];

    const focusables = () =>
      Array.from(
        drawer.querySelectorAll<HTMLElement>('a[href], button:not([disabled]), [tabindex]:not([tabindex="-1"])'),
      ).filter((el) => el.offsetParent !== null);

    const setExpanded = (value: boolean) =>
      openers.forEach((button) => button.setAttribute("aria-expanded", String(value)));

    const lockScroll = (lock: boolean) => {
      const root = document.documentElement;
      if (lock) {
        // compensate for a disappearing scrollbar so nothing shifts sideways
        const gap = window.innerWidth - root.clientWidth;
        root.style.setProperty("--scroll-gap", `${gap}px`);
        root.classList.add("drawer-locked");
      } else {
        root.classList.remove("drawer-locked");
        root.style.removeProperty("--scroll-gap");
      }
    };

    const open = (from: HTMLElement | null) => {
      if (drawer.classList.contains("is-open")) return;
      opener = from;
      drawer.removeAttribute("inert");
      // everything else on the page goes inert: no focus, no clicks, no AT
      inerted = Array.from(document.body.children).filter(
        (el) => el !== drawer && el !== scrim && !el.hasAttribute("inert") && el.tagName !== "SCRIPT",
      );
      inerted.forEach((el) => el.setAttribute("inert", ""));
      drawer.classList.add("is-open");
      scrim.classList.add("is-open");
      setExpanded(true);
      lockScroll(true);
      // focus the current chamber if there is one, else the close button
      const here = drawer.querySelector<HTMLElement>(".drawer-link.is-here");
      (here ?? drawer.querySelector<HTMLElement>("[data-drawer-close]"))?.focus({ preventScroll: true });
    };

    const close = (restoreFocus = true) => {
      if (!drawer.classList.contains("is-open")) return;
      drawer.classList.remove("is-open");
      scrim.classList.remove("is-open");
      drawer.style.removeProperty("transform");
      drawer.setAttribute("inert", "");
      inerted.forEach((el) => el.removeAttribute("inert"));
      inerted = [];
      setExpanded(false);
      lockScroll(false);
      if (restoreFocus) opener?.focus({ preventScroll: true });
    };

    openers.forEach((button) => button.addEventListener("click", () => open(button)));
    scrim.addEventListener("click", () => close());
    drawer.querySelector("[data-drawer-close]")?.addEventListener("click", () => close());

    // any link closes it — the page it leads to is the answer
    drawer
      .querySelectorAll<HTMLAnchorElement>("a[href]")
      .forEach((link) => link.addEventListener("click", () => close(false)));

    // zones fold
    drawer.querySelectorAll<HTMLButtonElement>(".zone-toggle").forEach((toggle) => {
      toggle.addEventListener("click", () => {
        const list = document.getElementById(toggle.getAttribute("aria-controls") ?? "");
        const expanded = toggle.getAttribute("aria-expanded") === "true";
        toggle.setAttribute("aria-expanded", String(!expanded));
        if (list) list.hidden = expanded;
      });
    });

    // Esc, and a focus trap for Tab / Shift+Tab
    document.addEventListener("keydown", (event) => {
      if (!drawer.classList.contains("is-open")) return;
      if (event.key === "Escape") {
        event.preventDefault();
        close();
        return;
      }
      if (event.key !== "Tab") return;
      const items = focusables();
      if (!items.length) return;
      const first = items[0];
      const last = items[items.length - 1];
      if (!first || !last) return;
      if (event.shiftKey && document.activeElement === first) {
        event.preventDefault();
        last.focus();
      } else if (!event.shiftKey && document.activeElement === last) {
        event.preventDefault();
        first.focus();
      }
    });

    // a left swipe sends it back. The drawer follows the finger; past 60px it
    // goes, short of that it springs home.
    let startX = 0;
    let startY = 0;
    let dx = 0;
    let tracking = false;
    let horizontal: boolean | null = null;

    drawer.addEventListener("pointerdown", (event) => {
      if (event.pointerType === "mouse") return;
      tracking = true;
      horizontal = null;
      startX = event.clientX;
      startY = event.clientY;
      dx = 0;
    });
    drawer.addEventListener("pointermove", (event) => {
      if (!tracking) return;
      const mx = event.clientX - startX;
      const my = event.clientY - startY;
      if (horizontal === null && Math.abs(mx) + Math.abs(my) > 8) horizontal = Math.abs(mx) > Math.abs(my);
      if (!horizontal) return;
      dx = Math.min(0, mx);
      drawer.classList.add("is-dragging");
      drawer.style.transform = `translateX(${dx}px)`;
    });
    const release = () => {
      if (!tracking) return;
      tracking = false;
      drawer.classList.remove("is-dragging");
      drawer.style.removeProperty("transform");
      if (horizontal && dx < -60) close();
    };
    drawer.addEventListener("pointerup", release);
    drawer.addEventListener("pointercancel", release);

    // grow past the breakpoint with it open → the rail is a column again
    desktop.addEventListener("change", (event) => {
      if (event.matches) close(false);
    });
  }
</script>

<style>
  .drawer-scrim,
  .drawer {
    display: none;
  }

  @media (max-width: 1100px) {
    .drawer-scrim {
      display: block;
      position: fixed;
      inset: 0;
      z-index: 90;
      background: rgb(10 12 15 / 62%);
      opacity: 0;
      pointer-events: none;
      transition: opacity var(--dur-2) var(--ease-in);
    }
    .drawer-scrim.is-open {
      opacity: 1;
      pointer-events: auto;
      transition: opacity var(--dur-3) var(--ease-out);
    }

    .drawer {
      display: flex;
      flex-direction: column;
      position: fixed;
      top: 0;
      left: 0;
      z-index: 91;
      width: min(calc(100vw - var(--s-9)), 352px);
      height: 100vh;
      height: 100dvh;
      padding: env(safe-area-inset-top) 0 env(safe-area-inset-bottom) env(safe-area-inset-left);
      box-sizing: border-box;
      overflow-y: auto;
      overscroll-behavior: contain;
      touch-action: pan-y;
      /* Zone I ground: the descent starts in the rock. One flat fill, one
         hard edge — the shaft wall at emphasis weight. */
      background: var(--rock-deep);
      color: var(--parchment);
      border-right: var(--rule-2) solid var(--line-strong);
      font-family: Georgia, "Times New Roman", serif;
      transform: translateX(-100%);
      visibility: hidden;
      transition:
        transform var(--dur-2) var(--ease-in),
        visibility 0s linear var(--dur-2);
      will-change: transform;
    }
    .drawer.is-open {
      transform: translateX(0);
      visibility: visible;
      transition:
        transform var(--dur-3) var(--ease-out),
        visibility 0s;
    }
    .drawer.is-dragging {
      transition: none;
    }
  }

  .drawer-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-4);
    min-height: var(--nav-h, 64px);
    padding: 0 var(--s-2) 0 var(--s-5);
    border-bottom: var(--rule) solid var(--line);
  }
  .drawer-home {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap);
    color: inherit;
    text-decoration: none;
    font-size: var(--t-ui);
    letter-spacing: var(--track-caps);
    text-transform: uppercase;
  }
  .drawer-close {
    position: relative;
    display: grid;
    place-items: center;
    width: var(--tap);
    height: var(--tap);
    border: 0;
    background: transparent;
    color: inherit;
    cursor: pointer;
  }

  .drawer-nav {
    flex: 1 0 auto;
    padding: var(--s-5) 0;
  }
  /* the pilgrim's row: two quiet columns over one hairline */
  .drawer-pilgrim {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    column-gap: var(--s-4);
    list-style: none;
    margin: 0 var(--s-5) var(--s-5);
    padding: 0 0 var(--s-4);
    border-bottom: var(--rule) solid var(--line);
  }
  /* top-aligned, so a two-line name ("Programul slujbelor") keeps its
     first line on its neighbour's */
  .pilgrim-link {
    display: flex;
    align-items: flex-start;
    min-height: var(--tap-min);
    padding: var(--s-3) 0 var(--s-2);
    color: color-mix(in srgb, currentColor 84%, transparent);
    text-decoration: none;
    font-size: var(--t-ui);
    line-height: 1.25;
  }
  .pilgrim-link.is-here {
    color: var(--ochre);
  }
  .pilgrim-link:active {
    background: rgb(244 239 228 / 8%);
  }
  .drawer-strata,
  .zone-chambers {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .zone-group {
    position: relative;
    padding: 0 var(--s-2) var(--s-2) var(--s-5);
  }
  /* the rail is a shaft: one hairline, ticked per stratum; the stratum you
     are in draws its shaft at emphasis weight */
  .zone-group::before {
    content: "";
    position: absolute;
    left: var(--s-5);
    top: var(--s-5);
    bottom: 0;
    width: var(--rule);
    background: var(--line);
  }
  .zone-group.is-current::before {
    width: var(--rule-2);
    background: var(--line-strong);
  }
  .zone-group:last-child::before {
    display: none;
  }
  .is-rock {
    --zone-tick: var(--rock-lilac);
  }
  .is-green {
    --zone-tick: var(--green-sage);
  }
  .is-gold {
    --zone-tick: var(--gold);
  }
  .is-river {
    --zone-tick: var(--river);
  }

  .zone-row {
    display: flex;
    align-items: center;
    gap: var(--s-1);
  }
  .zone-head {
    position: relative;
    flex: 1;
    display: flex;
    align-items: center;
    gap: var(--s-3);
    min-height: var(--tap);
    padding-left: var(--s-4);
    color: inherit;
    text-decoration: none;
    font-size: 13px;
    letter-spacing: var(--track-kicker);
    text-transform: uppercase;
  }
  .zone-head::before {
    content: "";
    position: absolute;
    left: -3px;
    top: calc(50% - var(--s-1));
    width: var(--s-2);
    height: var(--s-2);
    background: var(--zone-tick);
  }
  .is-current .zone-head::before {
    background: var(--ochre);
  }

  .zone-toggle {
    position: relative;
    flex: 0 0 var(--tap);
    height: var(--tap);
    border: 0;
    background: transparent;
    color: inherit;
    cursor: pointer;
    opacity: 0.7;
  }
  .zone-toggle span {
    position: absolute;
    left: 50%;
    top: 50%;
    width: var(--s-2);
    height: var(--s-2);
    margin: -6px 0 0 -4px;
    border-right: var(--rule-2) solid currentColor;
    border-bottom: var(--rule-2) solid currentColor;
    transform: rotate(45deg);
    transition: transform var(--dur-2) var(--ease-out);
  }
  .zone-toggle[aria-expanded="false"] span {
    transform: rotate(-45deg);
    margin-top: -4px;
  }

  .zone-chambers {
    padding: 0 0 var(--s-2) var(--s-4);
  }
  .drawer-link {
    position: relative;
    display: flex;
    align-items: center;
    min-height: var(--tap-min);
    padding: 0 var(--s-3) 0 var(--s-5);
    color: inherit;
    text-decoration: none;
    font-size: 17px;
    line-height: 1.3;
    color: color-mix(in srgb, currentColor 84%, transparent);
  }
  .drawer-link.is-here {
    color: var(--ochre);
  }
  .drawer-link.is-here::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: var(--rule-2);
    background: var(--line-strong);
  }
  .drawer-link:active,
  .zone-head:active {
    background: rgb(244 239 228 / 8%);
  }

  .drawer-langs {
    display: flex;
    padding: var(--s-4) var(--s-5) var(--s-5);
    border-top: var(--rule) solid var(--line);
  }
  .drawer-lang {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: var(--tap);
    min-height: var(--tap);
    color: inherit;
    text-decoration: none;
    font-size: 15px;
    line-height: 1;
    letter-spacing: 0.06em;
    border: var(--rule) solid rgb(244 239 228 / 24%);
  }
  .drawer-find {
    display: inline-flex;
    align-items: center;
    gap: var(--s-2);
    min-height: var(--tap);
    margin-left: auto;
    padding: 0 var(--s-4);
    border: var(--rule) solid rgb(244 239 228 / 24%);
    color: inherit;
    font-size: var(--t-ui);
    text-decoration: none;
  }
  /* one joined strip: neighbours share a single hairline */
  .drawer-lang + .drawer-lang {
    margin-left: calc(var(--rule) * -1);
  }
  .drawer-lang.is-current {
    position: relative;
    z-index: 1;
    border-color: var(--ochre);
    color: var(--ochre);
  }
  .drawer-lang.is-current::after {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: var(--rule-2);
    background: var(--ochre);
  }

  .drawer :focus-visible {
    outline: var(--rule-2) solid var(--ochre);
    outline-offset: calc(var(--rule-2) * -1);
  }

  /* zones arrive one after another — a short fall, ≤40ms apart */
  @media (max-width: 1100px) {
    .drawer.is-open .zone-group,
    .drawer.is-open .drawer-langs {
      animation: drawer-rise var(--dur-2) var(--ease-out) both;
      animation-delay: calc(var(--dur-1) + var(--i, 4) * 30ms);
    }
  }
  /* zones are set in place, one after another — a short hard slide */
  @keyframes drawer-rise {
    from {
      opacity: 0;
      transform: translateX(calc(var(--s-2) * -1));
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .drawer,
    .drawer.is-open,
    .drawer-scrim,
    .drawer-scrim.is-open,
    .zone-toggle span {
      transition: none !important;
    }
    .drawer.is-open .zone-group,
    .drawer.is-open .drawer-langs {
      animation: none !important;
    }
  }
</style>

<style is:global>
  /* scroll lock while the drawer is open — no sideways jump */
  html.drawer-locked,
  html.drawer-locked body {
    overflow: hidden;
  }
  html.drawer-locked body {
    padding-right: var(--scroll-gap, 0px);
  }
</style>
