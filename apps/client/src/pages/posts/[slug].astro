---
// A post is a chamber with a date. Most of the chronicle's entries carry no
// prose at all — for those the title, the date and the photographs are the
// entry, and the chamber must not look broken for saying so.
import Chamber from "@layouts/Chamber.astro";
import { getAllPostSlugs, getPostBySlug, getPostNeighbours, getPublishedPosts } from "@data/posts";
import { getLocaleFromUrl, getLocalizedPath, useTranslations } from "@i18n/utils";
import Icon from "@components/marks/Icon.astro";
import { rebase } from "@data/pages";
import { getEntry } from "astro:content";

export async function getStaticPaths() {
  const slugs = await getAllPostSlugs();

  return slugs.map((slug) => ({ params: { slug } }));
}

const lang = getLocaleFromUrl(Astro.url);
const t = useTranslations(lang);
const slug = Astro.params.slug as string;
const post = await getPostBySlug(slug, lang);
const posts = await getPublishedPosts(lang);
const { newer, older } = getPostNeighbours(posts, slug);
const href = (path: string) => getLocalizedPath(path, lang);

// The excerpt is the opening of the body. Printed as the lead above that same
// body it reads twice; it leads only an entry that has no prose of its own.
const opening = post ? post.body.join(" ").replace(/\s+/g, " ") : "";
const excerptStem = post ? post.excerpt.replace(/…$/, "") : "";
const lead = post && excerptStem && !opening.startsWith(excerptStem) ? post.excerpt : undefined;

// A video entry's photograph becomes the video's poster rather than a second picture.
const videos = post?.videos ?? [];
const showLead = Boolean(post?.image) && videos.length === 0;

// Everything the lightbox steps through, in page order.
const plates = post
  ? [
      ...(showLead && post.image
        ? [
            {
              src: post.image.url,
              thumb: post.image.thumb,
              width: post.image.width ?? 0,
              height: post.image.height ?? 0,
            },
          ]
        : []),
      ...post.galleryImages,
    ]
  : [];
// The body as markdown, not as raw paragraphs: entries written in the admin
// carry bold, links, headings and photographs. Site paths get the base path
// and the reader's locale, as in the chambers.
const entry = post ? await getEntry("posts", post.id) : undefined;
const bodyHtml = entry?.rendered?.html ? rebase(entry.rendered.html, lang) : "";
const shown = post ? (post.image ? 1 : 0) + post.galleryImages.length : 0;
---

{
  post ? (
    <Chamber zone={post.zone} title={post.title} eyebrow={post.date} {...(lead ? { lead } : {})}>
      {post.isFallback && <p class="fallback">{t("zone.fallbackNote")}</p>}

      {showLead && post.image && (
        <a class="lead-image" href={post.image.url} data-plate={0} aria-label={post.title}>
          <picture>
            <source media="(max-width: 720px)" srcset={post.image.smallSrcset} sizes="calc(100vw - 32px)" />
            <img
              src={post.image.url}
              srcset={post.image.srcset}
              sizes="(max-width: 1100px) 92vw, 720px"
              width={post.image.width}
              height={post.image.height}
              alt={post.image.alt}
              fetchpriority="high"
            />
          </picture>
        </a>
      )}

      {videos.map((id, index) => (
        <div class="video">
          <a
            class="video-facade"
            href={`https://www.youtube.com/watch?v=${id}`}
            data-video={id}
            data-title={post.title}
            target="_blank"
            rel="noopener"
            aria-label={`${t("home.playVideo")}: ${post.title} (YouTube)`}>
            {index === 0 && post.image && (
              <img
                src={post.image.thumb}
                srcset={post.image.smallSrcset}
                sizes="(max-width: 720px) 100vw, 720px"
                alt=""
              />
            )}
            <span class="play" aria-hidden="true">
              <Icon name="play" size={28} />
            </span>
            <span class="video-label">{`${t("home.playVideo")} · YouTube`}</span>
          </a>
        </div>
      ))}

      {bodyHtml ? <div class="post-body" set:html={bodyHtml} /> : post.body.map((paragraph) => <p>{paragraph}</p>)}

      {post.galleryImages.length > 0 && (
        <div class="post-gallery">
          {post.galleryImages.map((plate, index) => (
            <a
              href={plate.src}
              data-plate={index + (plates.length - post.galleryImages.length)}
              aria-label={`${post.title} · ${index + 1}`}>
              <img
                src={plate.thumb}
                srcset={`${plate.thumb} 360w, ${plate.src} 800w`}
                sizes="(max-width: 620px) 50vw, 280px"
                width="360"
                height="270"
                alt=""
                loading="lazy"
                decoding="async"
              />
            </a>
          ))}
        </div>
      )}

      {post.archiveImages > shown && (
        <p class="archive-note">{`${post.archiveImages} ${t("gallery.count")} · ${t("zone.sourceNote")}`}</p>
      )}

      <footer class="entry-foot">
        {post.author && <p class="author">{post.author}</p>}
        <nav class="neighbours" aria-label={t("zone.cronica")}>
          {older && (
            <a class="older" href={href(`/posts/${older.slug}`)} rel="prev">
              <span class="dir">
                <Icon name="arrow-left" size={16} />
              </span>
              <span class="what">{older.title}</span>
            </a>
          )}
          {newer && (
            <a class="newer" href={href(`/posts/${newer.slug}`)} rel="next">
              <span class="dir">
                <Icon name="arrow-right" size={16} />
              </span>
              <span class="what">{newer.title}</span>
            </a>
          )}
        </nav>
        <a class="all" href={href("/posts")}>
          {t("home.allNews")}
        </a>
      </footer>

      {plates.length > 0 && (
        <dialog
          class="lightbox"
          id="lightbox"
          aria-label={post.title}
          data-plates={JSON.stringify(plates.map((plate) => plate.src))}>
          <img id="lightbox-image" alt="" />
          <p class="lightbox-count" id="lightbox-count" aria-live="polite" />
          <div class="lightbox-controls">
            <button type="button" data-step="-1" aria-label={t("gallery.previous")}>
              <Icon name="arrow-left" />
            </button>
            <button type="button" data-close aria-label={t("gallery.close")}>
              <Icon name="close" />
            </button>
            <button type="button" data-step="1" aria-label={t("gallery.next")}>
              <Icon name="arrow-right" />
            </button>
          </div>
        </dialog>
      )}
    </Chamber>
  ) : (
    <Chamber zone="green" title={t("news.notFoundTitle")} lead={t("news.notFoundDescription")}>
      <p>
        <a href={href("/posts")}>{t("news.backToArticles")}</a>
      </p>
    </Chamber>
  )
}

<script>
  // Videos load only when asked for: until then the page makes no request to
  // YouTube at all, and without script the facade is a plain link out.
  document.querySelectorAll<HTMLAnchorElement>("[data-video]").forEach((facade) => {
    facade.addEventListener("click", (event) => {
      event.preventDefault();
      const frame = document.createElement("iframe");
      frame.src = `https://www.youtube-nocookie.com/embed/${facade.dataset.video}?autoplay=1&rel=0`;
      frame.title = facade.dataset.title ?? "YouTube";
      frame.allow = "autoplay; encrypted-media; picture-in-picture; fullscreen";
      frame.allowFullscreen = true;
      frame.referrerPolicy = "strict-origin-when-cross-origin";
      facade.replaceWith(frame);
    });
  });

  // One lightbox per entry: tap a photograph, step with the arrows, the keys
  // or a swipe; the backdrop, ✕ or Escape leaves.
  const dialog = document.getElementById("lightbox") as HTMLDialogElement | null;
  const image = document.getElementById("lightbox-image") as HTMLImageElement | null;
  const count = document.getElementById("lightbox-count");

  if (dialog && image) {
    const plates = JSON.parse(dialog.dataset.plates ?? "[]") as string[];
    let position = 0;

    const show = (index: number) => {
      position = (index + plates.length) % plates.length;
      image.src = plates[position] ?? "";
      if (count) count.textContent = `${position + 1} / ${plates.length}`;
    };

    document.querySelectorAll<HTMLAnchorElement>("[data-plate]").forEach((link) => {
      link.addEventListener("click", (event) => {
        event.preventDefault();
        show(Number(link.dataset.plate));
        dialog.showModal();
      });
    });

    dialog.querySelectorAll<HTMLButtonElement>("[data-step]").forEach((button) => {
      button.addEventListener("click", () => show(position + Number(button.dataset.step)));
    });
    dialog.querySelector("[data-close]")?.addEventListener("click", () => dialog.close());
    dialog.addEventListener("click", (event) => {
      if (event.target === dialog) dialog.close();
    });
    document.addEventListener("keydown", (event) => {
      if (!dialog.open) return;
      if (event.key === "ArrowRight") show(position + 1);
      if (event.key === "ArrowLeft") show(position - 1);
    });

    let startX = 0;
    let startY = 0;
    image.addEventListener(
      "touchstart",
      (event) => {
        startX = event.touches[0]?.clientX ?? 0;
        startY = event.touches[0]?.clientY ?? 0;
      },
      { passive: true },
    );
    image.addEventListener("touchend", (event) => {
      const dx = (event.changedTouches[0]?.clientX ?? 0) - startX;
      const dy = (event.changedTouches[0]?.clientY ?? 0) - startY;
      if (Math.abs(dx) > 40 && Math.abs(dx) > Math.abs(dy)) show(position + (dx < 0 ? 1 : -1));
    });
  }
</script>

<style>
  .fallback,
  .archive-note {
    font-size: var(--t-meta);
    line-height: 1.55;
    font-style: italic;
    opacity: 0.72;
    margin-bottom: var(--s-6);
  }
  .archive-note {
    margin-top: var(--s-5);
  }

  .lead-image {
    display: block;
    margin: 0 0 var(--s-8);
  }
  .lead-image img {
    display: block;
    width: 100%;
    height: auto;
    margin: 0;
  }
  /* a portrait photograph must not take three screens of the column */
  .lead-image img[height] {
    width: auto;
    max-width: 100%;
    max-height: min(78vh, 760px);
  }

  /* 16:9 on every width; nothing from YouTube loads until the facade is used */
  .video {
    position: relative;
    aspect-ratio: 16 / 9;
    margin: 0 0 var(--s-8);
    background: var(--night-green);
  }
  .video > :global(iframe),
  .video-facade {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }
  .video-facade {
    display: grid;
    place-items: center;
    color: var(--parchment);
    text-decoration: none;
    overflow: hidden;
  }
  .video-facade img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    margin: 0;
    object-fit: cover;
    opacity: 0.62;
  }
  /* a square stop, not a round button: flat fill, emphasis frame */
  .play {
    position: relative;
    width: var(--s-10);
    height: var(--s-10);
    background: var(--night-green);
    border: var(--rule-2) solid var(--ochre);
    display: grid;
    place-items: center;
    color: var(--parchment);
    transition: background-color var(--dur-1) var(--ease-out);
  }
  .video-facade:hover .play,
  .video-facade:focus-visible .play {
    background: var(--ochre);
  }
  .video-label {
    position: absolute;
    left: var(--s-4);
    bottom: var(--s-3);
    font-size: var(--t-meta);
  }

  /* a plain grid, not a list: the chamber's prose list styling must not reach it */
  /* the same lattice as the galerie: square fields, a 2px mullion */
  .post-gallery {
    margin: var(--s-8) 0 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(168px, 1fr));
    gap: var(--lattice);
    padding: var(--lattice);
    background: rgb(13 17 22 / 40%);
  }
  .post-gallery a {
    position: relative;
    display: block;
  }
  .post-gallery a::after {
    content: "";
    position: absolute;
    inset: 0;
    transition: background-color var(--dur-2) var(--ease-out);
  }
  .post-gallery a:hover::after {
    background: rgb(244 239 228 / 10%);
  }
  .post-gallery img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 1;
    object-fit: cover;
    margin: 0;
  }
  .post-gallery a:focus-visible,
  .lead-image:focus-visible {
    outline: var(--rule-2) solid var(--ochre);
    outline-offset: var(--rule-2);
  }

  .lightbox {
    /* centred in the top layer whatever the global reset does to margins */
    margin: auto;
    border: 0;
    padding: 0;
    max-width: min(96vw, 1400px);
    max-height: 96vh;
    background: transparent;
    color: var(--parchment);
  }
  .lightbox::backdrop {
    background: rgb(10 12 15 / 94%);
  }
  .lightbox img {
    display: block;
    max-width: 100%;
    max-height: 80vh;
    margin: 0 auto;
    object-fit: contain;
    touch-action: pan-y;
  }
  .lightbox-count {
    margin: var(--s-2) 0 0;
    text-align: center;
    font-size: var(--t-meta);
    font-variant-numeric: lining-nums tabular-nums;
    opacity: 0.72;
  }
  .lightbox-controls {
    display: flex;
    justify-content: center;
    gap: var(--lattice);
    margin-top: var(--s-2);
  }
  .lightbox-controls button {
    min-width: var(--s-9);
    min-height: var(--tap);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border: var(--rule) solid rgb(244 239 228 / 24%);
    background: var(--night);
    color: var(--parchment);
    font-size: 18px;
    padding: 0 var(--s-6);
    cursor: pointer;
    transition:
      background-color var(--dur-1) var(--ease-out),
      border-color var(--dur-1) var(--ease-out);
  }
  .lightbox-controls button:hover {
    border-color: rgb(244 239 228 / 72%);
    background: var(--rock-ground);
  }

  .entry-foot {
    margin-top: var(--s-9);
    padding-top: var(--s-5);
    border-top: var(--rule) solid var(--line);
  }
  .author {
    font-size: var(--t-meta);
    font-style: italic;
    opacity: 0.72;
    margin: 0 0 var(--s-5);
  }

  /* older | newer: two columns, no boxes; the title is the link */
  .neighbours {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--s-6);
  }
  .neighbours a {
    display: grid;
    align-content: start;
    gap: var(--s-1);
    min-height: var(--tap);
    padding: var(--s-2) 0;
    text-decoration: none;
    color: inherit;
  }
  .neighbours .newer {
    text-align: right;
    justify-items: end;
    grid-column: 2;
  }
  .dir {
    display: inline-flex;
    color: var(--ochre);
  }
  .what {
    font-size: var(--t-ui);
    line-height: 1.45;
    opacity: 0.88;
    text-decoration: underline;
    text-decoration-thickness: var(--rule);
    text-decoration-color: transparent;
    text-underline-offset: 0.22em;
    transition: text-decoration-color var(--dur-1) var(--ease-out);
  }
  .neighbours a:hover .what {
    text-decoration-color: currentColor;
  }

  .all {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap);
    margin-top: var(--s-5);
    font-size: var(--t-ui);
    color: var(--ochre);
    text-decoration: underline;
    text-decoration-thickness: var(--rule);
    text-decoration-color: color-mix(in srgb, currentColor 45%, transparent);
    text-underline-offset: 0.25em;
  }
  .all:hover {
    text-decoration-color: currentColor;
  }

  @media (max-width: 620px) {
    .post-gallery {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .neighbours {
      grid-template-columns: 1fr;
      gap: var(--s-3);
    }
    .neighbours .newer {
      grid-column: 1;
      text-align: left;
      justify-items: start;
    }
    .lightbox {
      max-width: 100vw;
      width: 100vw;
    }
  }
</style>
