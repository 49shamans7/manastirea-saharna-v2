---
// TEMPLATE A · STRATUM — home only. The four zones in one scroll, top to
// bottom: Stânca → Mănăstirea vie → Racla → Nistru (ARCHITECTURE.md). The
// page still darkens through the first three and opens onto the river.
//
// Each zone is presented the same calm way: a photograph of the place, then
// its words and its one job. No ornament stands in for meaning — the
// photographs are the place, the ground colours are measured from them.
//   I    the name, one line of purpose, the Pomelnic (first phone screen)
//   II   the hours and the chronicle
//   III  the shrine — photograph beside the prayer, the chambers behind it
//   IV   the practical: address, telephone, the four pages for the journey
//
// The horizontal reading of the same four zones is kept at /walk.
import Layout from "@layouts/Layout.astro";
import DescentRail from "@components/temple/DescentRail.astro";
import CalendarRail from "@components/temple/CalendarRail.astro";
import { getLocaleFromUrl, getLocalizedPath, telHref, useTranslations } from "@i18n/utils";
import { getRecentPosts } from "@data/posts";
import { schedule, serviceText } from "@data/schedule";
import type { AllTranslationKeys } from "@i18n";
import { zoneById } from "@temple/zones";
import { publicAsset } from "@utils/paths";

const lang = getLocaleFromUrl(Astro.url);
const t = useTranslations(lang);
const posts = await getRecentPosts(lang, 3);
const plate = (name: string) => publicAsset(`/plates/${name}.webp`);
// every plate ships at 1600w and 800w (scripts/build-plates.mjs)
const plateSet = (name: string) => `${publicAsset(`/plates/${name}-800.webp`)} 800w, ${plate(name)} 1600w`;
const plateSizes = "(min-width: 1101px) 900px, 100vw";
const href = (path: string) => getLocalizedPath(path, lang);

// One line of purpose under the name. The lead's second sentence describes
// the page rather than the monastery, so only its first sentence is used
// (as /walk already does).
const purpose = (t("home.descentLead").split(/(?<=\.)\s/)[0] ?? "").trim();

const goldChambers = zoneById.gold.pages;
const riverPages = zoneById.river.pages;
const phone = t("contact.phoneMain");
---

<Layout>
  <div class="descent">
    <DescentRail lang={lang} current={null} />

    <main class="descent-main">
      {/* ═══ I · STÂNCA — the name, the purpose, the Pomelnic ═══ */}
      <section class="zone z-rock" id="zona-rock" data-zone="rock" aria-labelledby="rock-head">
        <img
          class="photo photo-hero"
          src={plate("rock")}
          srcset={plateSet("rock")}
          sizes={plateSizes}
          alt=""
          width="800"
          height="600"
          loading="eager"
          fetchpriority="high"
          decoding="async"
        />
        <div class="col hero">
          <h1 id="rock-head" class="h1">{t("main.title")}</h1>
          <p class="dedication">{t("home.descentTitle")}</p>
          <p class="purpose">{purpose}</p>
          <div class="actions">
            <a class="btn btn-primary" href={href("/pomelnic")}>{t("notFound.pomelnic")}</a>
            <a class="btn btn-quiet" href={href("/slujbe")}>{t("nav.serviceSchedule")}</a>
          </div>
        </div>
      </section>

      {/* ═══ II · MĂNĂSTIREA VIE — the hours and the chronicle ═══ */}
      <section class="zone z-green" id="zona-green" data-zone="green" aria-labelledby="green-head">
        <figure class="figure" data-reveal>
          <img
            class="photo photo-wide"
            src={plate("green")}
          srcset={plateSet("green")}
          sizes={plateSizes}
            alt={t("gallery.complex")}
            width="800"
            height="600"
            loading="lazy"
            decoding="async"
          />
          <figcaption class="col caption">{t("gallery.complex")}</figcaption>
        </figure>

        <div class="col zone-body" data-reveal>
          <header class="zone-head">
            <h2 id="green-head" class="h2">{t("home.greenTitle")}</h2>
            <p class="lead">{t("home.greenLead")}</p>
          </header>

          <div class="pair">
            <section class="block" aria-labelledby="ceasuri">
              <h3 id="ceasuri" class="h3">{t("zone.slujbe")}</h3>
              {/* every day's order is in the page; a script shows today's (Chișinău time).
                  Without it, Monday–Wednesday stands, as before. */}
              {
                schedule.map((day) => (
                  <div class="day" data-day={day.key} hidden={day.key !== "monWed"}>
                    <p class="meta">{t(`schedule.${day.key}` as AllTranslationKeys)}</p>
                    {day.blocks.map((block) => (
                      <>
                        {block.titleKey && <p class="meta">{t(block.titleKey as AllTranslationKeys)}</p>}
                        <dl class="hours">
                          {block.services.map((h) => (
                            <div class="hour">
                              <dt>{h.time}</dt>
                              <dd>{serviceText(h.name, lang)}</dd>
                            </div>
                          ))}
                        </dl>
                      </>
                    ))}
                  </div>
                ))
              }
              <a class="more" href={href("/slujbe")}>{t("home.fullSchedule")}</a>
            </section>

            <section class="block" aria-labelledby="cronica-head">
              <h3 id="cronica-head" class="h3">{t("zone.cronica")}</h3>
              {
                posts.length > 0 ? (
                  <ul class="posts">
                    {posts.map((post) => (
                      <li>
                        <a href={href(`/posts/${post.slug}`)}>
                          <time datetime={post.isoDate}>{post.date}</time>
                          <span class="post-title">{post.title}</span>
                        </a>
                      </li>
                    ))}
                  </ul>
                ) : (
                  <p class="empty">{t("home.noPosts")}</p>
                )
              }
              <a class="more" href={href("/posts")}>{t("home.allNews")}</a>
            </section>
          </div>
        </div>
      </section>

      {
        /* ═══ III · RACLA — the hinge. You stop here. ═══
          The photograph stands beside the prayer, off the axis of the words:
          the relics are something you turn aside to, not pass through. */
      }
      <section class="zone z-gold" id="zona-gold" data-zone="gold" aria-labelledby="gold-head">
        <div class="col shrine" data-reveal>
          <picture class="photo-shrine-frame">
            {/* beside the text on wide screens the shrine stands as a 4:5 portrait */}
            <source media="(min-width: 900px)" srcset={plateSet("gold-door-portrait")} sizes="450px" />
            <img
            class="photo photo-shrine"
            src={plate("gold-door")}
            srcset={plateSet("gold-door")}
            sizes="100vw"
            alt={t("gallery.relics")}
            width="800"
            height="600"
            loading="lazy"
            decoding="async"
          />
          </picture>
          <div class="shrine-text">
            <h2 id="gold-head" class="h2 gold">{t("home.shrineTitle")}</h2>
            <blockquote class="prayer">{t("home.shrineQuote")}</blockquote>
            <ul class="rows">
              {
                goldChambers.map((p) => (
                  <li>
                    <a href={href(p.href)}>{t(p.labelKey)}</a>
                  </li>
                ))
              }
            </ul>
          </div>
        </div>
      </section>

      {/* ═══ IV · NISTRU — the practical: where, how, whom to call ═══ */}
      <section class="zone z-river" id="zona-river" data-zone="river" aria-labelledby="river-head">
        <img
          class="photo photo-river"
          src={plate("river")}
          srcset={plateSet("river")}
          sizes={plateSizes}
          alt=""
          width="800"
          height="600"
          loading="lazy"
          decoding="async"
        />
        <div class="col zone-body" data-reveal>
          <header class="zone-head">
            <h2 id="river-head" class="h2">{t("home.riverTitle")}</h2>
            <p class="lead">{t("home.riverLead")}</p>
          </header>

          <div class="pair">
            <dl class="facts">
              <div>
                <dt>{t("contact.addressLabel")}</dt>
                <dd>
                  {t("footer.addressName")}<br />
                  {t("footer.addressLine")}
                </dd>
              </div>
              <div>
                <dt>{t("contact.phoneMainLabel")}</dt>
                <dd><a class="tel" href={telHref(phone)}>{phone}</a></dd>
              </div>
            </dl>

            <ul class="rows rows-river">
              {
                riverPages.map((p) => (
                  <li>
                    <a href={href(p.href)}>{t(p.labelKey)}</a>
                  </li>
                ))
              }
            </ul>
          </div>
        </div>
      </section>
    </main>

    <CalendarRail lang={lang} />
  </div>
</Layout>

<script>
  // Mark the zone you are in, so the left rail reads as a position: the zone
  // that crosses the middle of the screen is the current one.
  const strata = document.querySelectorAll<HTMLElement>(".descent-main [data-zone]");
  const marks = new Map<string, Element>();

  document.querySelectorAll<HTMLElement>(".stratum-entry").forEach((entry) => {
    const zone = Array.from(entry.classList)
      .find((c) => c.startsWith("is-"))
      ?.slice(3);
    if (zone) marks.set(zone, entry);
  });

  if ("IntersectionObserver" in window && strata.length) {
    const observer = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          const zone = (e.target as HTMLElement).dataset.zone;
          if (zone) marks.get(zone)?.classList.toggle("is-current", e.isIntersecting);
        }
      },
      { rootMargin: "-50% 0px -50% 0px", threshold: 0 },
    );

    strata.forEach((s) => observer.observe(s));
  }

  // Content settles in as it is reached: opacity and 8px, once. Nothing at
  // all under reduced motion (the CSS never hides anything there).
  const revealables = document.querySelectorAll<HTMLElement>("[data-reveal]");
  const still = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  if (!still && "IntersectionObserver" in window) {
    const reveal = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          if (!e.isIntersecting) continue;
          e.target.classList.add("is-revealed");
          reveal.unobserve(e.target);
        }
      },
      { rootMargin: "0px 0px -8% 0px", threshold: 0 },
    );
    revealables.forEach((el) => reveal.observe(el));
  } else {
    revealables.forEach((el) => el.classList.add("is-revealed"));
  }

  // Return from a chamber lands at that zone's depth (#zona-<id>), never the
  // top: show its content at once and jump without smooth scrolling.
  if (location.hash.startsWith("#zona-")) {
    const target = document.querySelector<HTMLElement>(location.hash);
    target?.querySelectorAll("[data-reveal]").forEach((el) => el.classList.add("is-revealed"));
    target?.scrollIntoView({ behavior: "auto", block: "start" });
  }
</script>

<script>
  // today's order of services, by the monastery's clock
  const day = new Intl.DateTimeFormat("en-US", { timeZone: "Europe/Chisinau", weekday: "short" }).format(new Date());
  const key = ({ Mon: "monWed", Tue: "monWed", Wed: "monWed", Thu: "thu", Fri: "fri", Sat: "sat", Sun: "sun" } as Record<string, string>)[day];
  document.querySelectorAll<HTMLElement>("[data-day]").forEach((el) => {
    el.hidden = el.dataset.day !== key;
  });
</script>

<style>
  /* ─── the frame and the column ───────────────────────────────────────
     Same frame as every chamber (TempleFrame): rail | centre | rail. Inside
     the centre, one column and one vertical rhythm for all four zones. */
  .descent {
    --col-max: var(--centre-max);
    --col-pad: var(--s-5);
    --zone-pad: var(--s-9);
    --head-gap: var(--s-7);
    /* hairlines drawn from the ground's own text colour */
    --hair: color-mix(in srgb, currentColor 20%, transparent);
    --hair-strong: color-mix(in srgb, currentColor 55%, transparent);

    display: grid;
    grid-template-columns: var(--rail-l) minmax(0, var(--centre-max)) var(--rail-r);
    justify-content: center;
    gap: 0 var(--frame-gap);
    padding: 0 var(--frame-pad);
    background: var(--rock-deep);
    color: var(--parchment);
  }
  .descent-main {
    min-width: 0;
  }
  @media (min-width: 600px) {
    .descent {
      --col-pad: var(--s-7);
      --zone-pad: var(--s-11);
      --head-gap: var(--s-8);
    }
  }
  @media (min-width: 1101px) {
    .descent {
      --col-pad: var(--s-9);
      --zone-pad: var(--s-12);
      --head-gap: var(--s-9);
    }
  }
  @media (max-width: 1360px) {
    .descent {
      grid-template-columns: var(--rail-l) minmax(0, 1fr);
    }
  }
  @media (max-width: 1100px) {
    /* the rail is a drawer; the zones go full bleed */
    .descent {
      grid-template-columns: minmax(0, 1fr);
      padding: 0;
    }
  }

  /* below 1360px the calendar is a fold after the descent, on the column */
  @media (max-width: 1360px) {
    .descent > :global(.rail-right) {
      margin: 0;
      padding: var(--s-8) var(--col-pad) var(--s-9);
      border-top: 0;
    }
  }

  /* scroll reveal — phones and tablets. 8px, one duration, no overshoot. */
  @media (max-width: 1100px) and (prefers-reduced-motion: no-preference) {
    :global(html.js .descent [data-reveal]) {
      opacity: 0;
      transform: translateY(var(--s-2));
      transition:
        opacity var(--dur-3) var(--ease-out),
        transform var(--dur-3) var(--ease-out);
    }
    :global(html.js .descent [data-reveal].is-revealed) {
      opacity: 1;
      transform: none;
    }
  }

  .col {
    width: 100%;
    max-width: var(--col-max);
    margin: 0 auto;
    padding: 0 var(--col-pad);
  }

  /* ─── type: one hierarchy, sentence case, Georgia throughout ───────── */
  .h1,
  .h2,
  .h3 {
    margin: 0;
    font-weight: 400;
    text-wrap: balance;
    overflow-wrap: break-word;
  }
  .h1 {
    font-size: clamp(36px, 5.2vw, 64px);
    line-height: 1.08;
    letter-spacing: -0.005em;
  }
  .h2 {
    font-size: clamp(28px, 3.4vw, 44px);
    line-height: 1.15;
  }
  .h3 {
    padding-bottom: var(--s-3);
    border-bottom: var(--rule) solid var(--hair-strong);
    font-size: 21px;
    line-height: 1.3;
  }
  .lead {
    max-width: var(--measure);
    margin: var(--s-4) 0 0;
    font-size: 19px;
    line-height: 1.6;
    opacity: 0.86;
    text-wrap: pretty;
  }
  @media (min-width: 600px) {
    .lead {
      font-size: var(--t-lead);
    }
  }

  /* photographs: full colour, full strength, no overlay */
  .photo {
    display: block;
    width: 100%;
    height: auto;
    object-fit: cover;
  }
  .figure {
    margin: 0;
  }
  .caption {
    padding-top: var(--s-3);
    font-size: 14px;
    font-style: italic;
    line-height: 1.5;
    opacity: 0.7;
  }

  .zone {
    position: relative;
  }

  /* ─── I · STÂNCA ───────────────────────────────────────────────────── */
  .z-rock {
    background: var(--rock-deep);
    padding-bottom: var(--zone-pad);
  }
  .photo-hero {
    aspect-ratio: 4 / 3;
    object-position: 50% 78%;
  }
  .hero {
    padding-top: var(--s-6);
  }
  .dedication {
    margin: var(--s-2) 0 0;
    font-size: 19px;
    font-style: italic;
    line-height: 1.4;
    color: var(--gold);
  }
  .purpose {
    max-width: var(--measure);
    margin: var(--s-4) 0 0;
    font-size: 18px;
    line-height: 1.55;
    opacity: 0.86;
    text-wrap: pretty;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-3);
    margin-top: var(--s-6);
  }
  .btn {
    flex: 1 1 100%;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: var(--tap);
    padding: var(--s-3) var(--s-5);
    border: var(--rule) solid transparent;
    font-size: 17px;
    line-height: 1.3;
    text-align: center;
    text-decoration: none;
    transition:
      background-color var(--dur-1) var(--ease-out),
      border-color var(--dur-1) var(--ease-out),
      color var(--dur-1) var(--ease-out);
  }
  .btn-primary {
    background: var(--parchment);
    color: var(--ink);
  }
  .btn-primary:hover {
    background: var(--gold);
  }
  .btn-quiet {
    border-color: var(--hair-strong);
    color: var(--parchment);
  }
  .btn-quiet:hover {
    border-color: var(--parchment);
  }
  @media (min-width: 600px) {
    .photo-hero {
      aspect-ratio: 16 / 9;
    }
    .hero {
      padding-top: var(--s-8);
    }
    .btn {
      flex: 0 0 auto;
      padding-inline: var(--s-6);
    }
  }
  @media (min-width: 1101px) {
    .photo-hero {
      aspect-ratio: auto;
      height: clamp(320px, 50vh, 520px);
    }
    .dedication {
      font-size: 22px;
    }
    .purpose {
      font-size: var(--t-lead);
    }
  }

  /* ─── II · MĂNĂSTIREA VIE ──────────────────────────────────────────── */
  .z-green {
    background: var(--green);
    padding-bottom: var(--zone-pad);
  }
  .photo-wide {
    aspect-ratio: 3 / 2;
    object-position: 50% 58%;
  }
  @media (min-width: 600px) {
    .photo-wide {
      aspect-ratio: 2 / 1;
    }
  }
  .zone-body {
    padding-top: var(--s-8);
  }
  @media (min-width: 600px) {
    .zone-body {
      padding-top: var(--s-10);
    }
  }

  .pair {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--s-8);
    margin-top: var(--head-gap);
  }
  @media (min-width: 768px) {
    .pair {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--s-8);
    }
  }

  .meta {
    margin: var(--s-3) 0 0;
    font-size: 15px;
    font-style: italic;
    line-height: 1.5;
    opacity: 0.72;
  }
  .hours {
    margin: var(--s-2) 0 0;
  }
  .hour {
    display: grid;
    grid-template-columns: var(--s-10) minmax(0, 1fr);
    align-items: baseline;
    border-bottom: var(--rule) solid var(--hair);
  }
  .hours dt,
  .hours dd {
    margin: 0;
    padding: var(--s-3) 0;
    line-height: 1.5;
  }
  .hours dt {
    font-variant-numeric: tabular-nums lining-nums;
  }

  .posts {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .posts a {
    display: grid;
    gap: var(--s-1);
    padding: var(--s-4) 0;
    border-bottom: var(--rule) solid var(--hair);
    color: inherit;
    text-decoration: none;
  }
  .posts time {
    font-size: 14px;
    line-height: 1.4;
    opacity: 0.68;
    font-variant-numeric: lining-nums;
  }
  .post-title {
    font-size: 17px;
    line-height: 1.45;
    text-decoration: underline;
    text-decoration-color: transparent;
    text-underline-offset: 0.2em;
    text-decoration-thickness: var(--rule);
    transition: text-decoration-color var(--dur-1) var(--ease-out);
  }
  .posts a:hover .post-title {
    text-decoration-color: currentColor;
  }
  .empty {
    margin: 0;
    padding: var(--s-4) 0;
    border-bottom: var(--rule) solid var(--hair);
    font-style: italic;
    opacity: 0.6;
  }

  /* a block closes with one plain text link, underlined */
  .more {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap);
    margin-top: var(--s-2);
    font-size: 16px;
    color: inherit;
    text-decoration: underline;
    text-decoration-color: var(--hair-strong);
    text-underline-offset: 0.25em;
    text-decoration-thickness: var(--rule);
    transition: text-decoration-color var(--dur-1) var(--ease-out);
  }
  .more:hover {
    text-decoration-color: currentColor;
  }

  /* ─── III · RACLA ──────────────────────────────────────────────────── */
  .z-gold {
    background: var(--pall);
    padding: var(--zone-pad) 0;
  }
  .shrine {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--s-7);
  }
  .photo-shrine-frame {
    display: block;
  }
  .photo-shrine {
    aspect-ratio: 4 / 3;
    object-position: 40% 50%;
  }
  @media (max-width: 899px) {
    /* on a phone every photograph runs edge to edge; the zone opens on it */
    .z-gold {
      padding-top: 0;
    }
    .photo-shrine {
      width: calc(100% + 2 * var(--col-pad));
      max-width: none;
      margin-inline: calc(-1 * var(--col-pad));
    }
  }
  @media (min-width: 600px) and (max-width: 899px) {
    .photo-shrine {
      aspect-ratio: 2 / 1;
    }
  }
  .gold {
    color: var(--gold);
  }
  .prayer {
    max-width: var(--measure-gold);
    margin: var(--s-5) 0 0;
    padding-left: var(--s-5);
    border-left: var(--rule-2) solid var(--gold);
    font-size: var(--t-quote);
    font-style: italic;
    line-height: 1.6;
    opacity: 0.9;
  }
  @media (min-width: 900px) {
    /* the photograph beside the words, off their axis */
    .shrine {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: var(--s-8);
      align-items: start;
    }
    .photo-shrine-frame {
      order: 2;
    }
    .photo-shrine {
      aspect-ratio: 4 / 5;
    }
  }

  /* ruled rows of plain links — the chambers behind a zone */
  .rows {
    list-style: none;
    max-width: var(--measure-gold);
    margin: var(--s-7) 0 0;
    padding: 0;
    border-top: var(--rule) solid var(--hair-strong);
  }
  .rows a {
    display: flex;
    align-items: center;
    min-height: var(--tap);
    padding: var(--s-2) 0;
    border-bottom: var(--rule) solid var(--hair);
    color: inherit;
    font-size: 17px;
    line-height: 1.4;
    text-decoration: none;
    transition: color var(--dur-1) var(--ease-out);
  }
  .z-gold .rows a:hover {
    color: var(--gold);
  }

  /* ─── IV · NISTRU — bright, practical, read in a car park ──────────── */
  .z-river {
    background: var(--river-pale);
    color: var(--river-ink);
    padding-bottom: var(--zone-pad);
  }
