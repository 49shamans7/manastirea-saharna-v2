---
// TEMPLATE C · TABLE — Zone IV. The two ways to give sit side by side
// (sideways on a phone); the bank details are a table you can copy from.
// Rechizite from the old site's /donatii/ page (msaharna-archive practical_info.json).
import TableLayout from "@layouts/TableLayout.astro";
import RiverMark from "@components/marks/RiverMark.astro";
import { getLocaleFromUrl, getLocalizedPath, useTranslations } from "@i18n/utils";

const lang = getLocaleFromUrl(Astro.url);
const t = useTranslations(lang);

const iban = t("donations.iban");
// read in fours, copied whole
const ibanGrouped = iban.replace(/(.{4})(?=.)/g, "$1 ");
const bank: { label: string; value: string; display?: string; copy?: boolean; iban?: boolean }[] = [
  { label: t("donations.beneficiaryLabel"), value: t("donations.monastery") },
  { label: t("donations.bankLabel"), value: t("donations.bank") },
  { label: t("donations.fiscalCodeLabel"), value: t("donations.fiscalCode"), copy: true },
  { label: t("donations.bankCodeLabel"), value: t("donations.bankCode"), copy: true },
  { label: t("donations.ibanLabel"), value: iban, display: ibanGrouped, copy: true, iban: true },
  { label: t("donations.addressLabel"), value: `${t("donations.address")}, ${t("donations.country")}` },
];
const paypal = `https://${t("donations.paypalValue")}`;
---

<TableLayout title={t("donations.title")} lead={t("donations.greeting")} mark="hands">
  <section class="t-section">
    <p class="t-text">{t("donations.message")}</p>
    <p class="t-text">{t("donations.detailsIntro")}</p>
  </section>

  <section class="t-section" aria-labelledby="cum-ajutati">
    <h2 class="t-kicker" id="cum-ajutati">{t("table.ways")}</h2>
    <ul class="r-drift t-drift">
      <li>
        <div class="t-card">
          <RiverMark name="hands" />
          <h3 class="t-card-title">{t("donations.bankDetailsTitle")}</h3>
          <p class="t-card-text">{t("table.bankText")}</p>
          <a class="t-btn is-primary" href="#rechizite">{t("table.seeDetails")}</a>
        </div>
      </li>
      <li>
        <div class="t-card">
          <RiverMark name="hands" />
          <h3 class="t-card-title">PayPal</h3>
          <p class="t-card-text">{t("table.paypalText")}</p>
          <a
            class="t-btn"
            href={paypal}
            rel="noopener"
            target="_blank"
            aria-label={`${t("donations.paypalLabel")}: ${t("donations.paypalValue")}`}>
            {t("donations.paypalValue")}
          </a>
        </div>
      </li>
      <li>
        <a class="t-card" href={getLocalizedPath("/pomelnic", lang)}>
          <RiverMark name="lamp" />
          <span class="t-card-title">{t("notFound.pomelnic")}</span>
          <span class="t-card-go" aria-hidden="true">→</span>
        </a>
      </li>
    </ul>
  </section>

  <section class="t-section" id="rechizite" aria-labelledby="rechizite-head">
    <h2 class="t-kicker" id="rechizite-head">{t("donations.bankDetailsTitle")}</h2>
    <dl class="t-bank">
      {
        bank.map((row) => (
          <div>
            <dt>{row.label}</dt>
            <dd class:list={[row.iban && "is-iban"]}>
              <span class="t-val" translate="no">
                {row.display ?? row.value}
              </span>
              {row.copy && (
                <button
                  type="button"
                  class="t-copy"
                  data-copy={row.value}
                  data-copied={t("donations.copied")}
                  aria-label={`${t("donations.copy")}: ${row.label}`}
                  hidden>
                  {t("donations.copy")}
                </button>
              )}
            </dd>
          </div>
        ))
      }
    </dl>
    <p class="t-small">{t("donations.bankNote")}</p>
  </section>
</TableLayout>

<script>
  // Copy buttons appear only where the Clipboard API exists; without it the
  // value is still plain selectable text on screen.
  if (navigator.clipboard) {
    document.querySelectorAll<HTMLButtonElement>("button.t-copy[data-copy]").forEach((button) => {
      const label = button.textContent?.trim() ?? "";

      button.hidden = false;
      button.addEventListener("click", async () => {
        try {
          await navigator.clipboard.writeText(button.dataset.copy ?? "");
          button.textContent = button.dataset.copied ?? label;
          button.dataset.done = "";
          window.setTimeout(() => {
            button.textContent = label;
            delete button.dataset.done;
          }, 2000);
        } catch {
          // permission denied: the text is still there to select by hand
        }
      });
    });
  }
</script>

<style>
  #rechizite {
    scroll-margin-top: calc(var(--nav-h, 80px) + 16px);
  }
  .t-copy[hidden] {
    display: none;
  }
</style>
