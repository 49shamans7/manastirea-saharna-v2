---
// TEMPLATE C · TABLE — Zone IV. Bank details are a table, not a page of prose.
// Rechizite from the old site's /donatii/ page (msaharna-archive practical_info.json).
import TableLayout from "@layouts/TableLayout.astro";
import { getLocaleFromUrl, useTranslations } from "@i18n/utils";

const lang = getLocaleFromUrl(Astro.url);
const t = useTranslations(lang);

const bank: { label: string; value: string; copy?: boolean }[] = [
  { label: t("donations.beneficiaryLabel"), value: t("donations.monastery") },
  { label: t("donations.bankLabel"), value: t("donations.bank") },
  { label: t("donations.fiscalCodeLabel"), value: t("donations.fiscalCode"), copy: true },
  { label: t("donations.bankCodeLabel"), value: t("donations.bankCode"), copy: true },
  { label: t("donations.ibanLabel"), value: t("donations.iban"), copy: true },
  { label: t("donations.addressLabel"), value: `${t("donations.address")}, ${t("donations.country")}` },
];
---

<TableLayout title={t("donations.title")} lead={t("donations.greeting")}>
  <p>{t("donations.message")}</p>
  <p>{t("donations.detailsIntro")}</p>

  <h2>{t("donations.bankDetailsTitle")}</h2>
  <dl>
    {
      bank.map((row) => (
        <>
          <dt>{row.label}</dt>
          <dd class:list={[row.copy && "copyable"]}>
            <span class="value" translate="no">
              {row.value}
            </span>
            {row.copy && (
              <button
                type="button"
                class="copy"
                data-copy={row.value}
                data-copied={t("donations.copied")}
                aria-label={`${t("donations.copy")}: ${row.label}`}
                hidden>
                {t("donations.copy")}
              </button>
            )}
          </dd>
        </>
      ))
    }
  </dl>
  <p class="note">{t("donations.bankNote")}</p>

  <h2>PayPal</h2>
  <p>
    <a
      class="tap"
      href={`https://${t("donations.paypalValue")}`}
      rel="noopener"
      target="_blank"
      aria-label={`${t("donations.paypalLabel")}: ${t("donations.paypalValue")}`}>
      {t("donations.paypalValue")}
    </a>
  </p>
</TableLayout>

<script>
  // Copy buttons appear only where the Clipboard API exists; without it the
  // value is still plain selectable text.
  if (navigator.clipboard) {
    document.querySelectorAll<HTMLButtonElement>("button.copy[data-copy]").forEach((button) => {
      const label = button.textContent?.trim() ?? "";

      button.hidden = false;
      button.addEventListener("click", async () => {
        try {
          await navigator.clipboard.writeText(button.dataset.copy ?? "");
          button.textContent = button.dataset.copied ?? label;
          window.setTimeout(() => (button.textContent = label), 2000);
        } catch {
          // permission denied: the text is still there to select by hand
        }
      });
    });
  }
</script>

<style>
  .note {
    font-size: var(--t-meta);
    color: var(--river-muted);
  }
  .copyable {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--s-2) var(--s-4);
  }
  .value {
    min-width: 0;
    overflow-wrap: anywhere;
    user-select: all;
    -webkit-user-select: all;
  }
  .copy {
    min-height: var(--tap-min);
    min-width: var(--tap-min);
    margin-left: auto;
    padding: 0 var(--s-4);
    border: var(--rule) solid var(--seal-gold);
    border-radius: var(--radius);
    background: transparent;
    color: var(--river-strong);
    font: inherit;
    font-size: var(--t-meta);
    cursor: pointer;
    transition:
      background-color var(--dur-1) var(--ease-out),
      color var(--dur-1) var(--ease-out);
  }
  .copy:hover {
    border-color: var(--river-strong);
    background: var(--river-strong);
    color: var(--river-ground);
  }
  .copy:focus-visible {
    outline: var(--rule-2) solid var(--river-strong);
    outline-offset: var(--rule-2);
  }
  @media print {
    .copy {
      display: none;
    }
  }
</style>
