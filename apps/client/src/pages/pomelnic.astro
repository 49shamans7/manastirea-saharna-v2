---
// THE WELL — Zone I. The pomelnic has exactly one home: the shaft, on the
// centre axis (ARCHITECTURE.md § What this settles). It wears the table's
// head and v1's colours: a white page, and down its middle one navy shaft
// with the gold mouth laid across it. The names are written inside the
// shaft and go down. All lines opaque.
import TableLayout from "@layouts/TableLayout.astro";
import PrayerRequestForm from "@components/PrayerRequestForm.astro";
import { getLocaleFromUrl, useTranslations } from "@i18n/utils";

const lang = getLocaleFromUrl(Astro.url);
const t = useTranslations(lang);
const guide = [
  "pomelnicPage.guide1",
  "pomelnicPage.guide2",
  "pomelnicPage.guide3",
  "pomelnicPage.guide4",
  "pomelnicPage.guide5",
  "pomelnicPage.guide6",
  "pomelnicPage.guide7",
  "pomelnicPage.guide8",
] as const;
---

<TableLayout
  title={t("pomelnic.title")}
  lead={t("pomelnicPage.lead")}
  kicker={t("table.zoneRock")}
  mark="lamp"
  zone="rock">
  <div class="well-page" id="pomelnic-form">
    {/* the house's own instructions, folded: read once, then the form */}
    <details class="guide">
      <summary>{t("pomelnicPage.guideTitle")}</summary>
      <div class="guide-body">
        {guide.map((key) => <p>{t(key)}</p>)}
      </div>
    </details>

    {/* the shaft: the form sits inside it, not beside it */}
    <div class="shaft">
      <div class="shaft-mouth" aria-hidden="true"></div>
      <div class="form-well">
        <PrayerRequestForm idPrefix="pomelnic-page" lang={lang} />
      </div>
      <div class="shaft-water" aria-hidden="true"></div>
    </div>
  </div>
</TableLayout>

<style>
  .well-page {
    max-width: 48rem;
    margin: 0 auto;
    scroll-margin-top: calc(var(--nav-h, 80px) + 16px);
  }

  /* the guide: one ruled row that opens; the text inside is prose */
  .guide {
    max-width: 40rem;
    margin: 0 auto clamp(40px, 6vh, 64px);
    border-top: 1px solid var(--t-edge);
    border-bottom: 1px solid var(--t-edge);
  }
  .guide summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    min-height: var(--t-row);
    font-size: 11px;
    letter-spacing: 0.32em;
    text-transform: uppercase;
    color: var(--t-ochre-ink);
    cursor: pointer;
    list-style: none;
  }
  .guide summary::-webkit-details-marker {
    display: none;
  }
  .guide summary::after {
    content: "";
    width: 8px;
    height: 8px;
    margin-right: 8px;
    border-right: 2px solid currentColor;
    border-bottom: 2px solid currentColor;
    transform: rotate(45deg) translate(-2px, -2px);
    transition: transform 0.24s ease;
  }
  .guide[open] summary::after {
    transform: rotate(-135deg);
  }
  .guide summary:focus-visible {
    outline: 2px solid var(--t-deep);
    outline-offset: 2px;
  }
  .guide-body {
    padding: 8px 0 24px;
    font-size: 16px;
    line-height: 1.7;
    color: var(--t-ink);
  }
  .guide-body p {
    margin: 0 0 1em;
  }
  .guide-body p:last-child {
    margin-bottom: 0;
  }
  @media (prefers-reduced-motion: reduce) {
    .guide summary::after {
      transition: none;
    }
  }

  /* The shaft: navy walls one step lighter than its fill, the gold mouth
     as the one heavy bar on the page, still water as the deep navy floor. */
  .shaft {
    --shaft-pad: 40px;
    position: relative;
    padding: 0 var(--shaft-pad);
    border-left: 2px solid #4f7088;
    border-right: 2px solid #4f7088;
    background: var(--t-deep);
  }
  .shaft-mouth {
    height: 8px;
    background: var(--t-ochre);
    /* the mouth spans the walls: it is laid across them */
    margin: 0 calc((var(--shaft-pad) + 2px + 8px) * -1) 48px;
  }
  .shaft-water {
    height: 80px;
    margin: 48px calc(var(--shaft-pad) * -1) 0;
    background: var(--t-ink);
    border-top: 1px solid #4f7088;
  }
  @media (max-width: 599px) {
    .shaft {
      --shaft-pad: 16px;
    }
    .shaft-mouth {
      margin-inline: calc((var(--shaft-pad) + 2px) * -1);
    }
    .shaft-water {
      height: 48px;
    }
  }

  /* the form is neutral; in the shaft it reads light on navy. Contrast:
     labels #F7F6F1 on navy 9.7, help #B9C6CF 6.0, the asterisk and links
     #C9B07A 5.0, the button's navy on #C9B07A 6.2. */
  .form-well {
    --field-label: #f7f6f1;
    --field-muted: #b9c6cf;
    --field-ink: var(--t-ink);
    --field-line: #fff;
    --f-accent: #c9b07a;
    --f-focus: #c9b07a;
    --f-button: #c9b07a;
    --f-button-ink: var(--t-ink);
    --f-button-hover: #f7f6f1;
    --f-placeholder: #5f6b76;
  }
</style>
