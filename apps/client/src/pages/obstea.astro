---
// OBȘTEA — Zone II. The old page is forty-two words and three photographs:
// "Clerul Sfintei Mănăstiri", 2012, 2013, 2014. No amount of curation invents
// a fourth, so the chamber is built around what exists rather than padded to
// look like a page. The three years are the content.
//
// Each is a different season and a different vestment colour — green in high
// summer, blue and white in deep snow, black habits under bare trees. Stacked
// in order they descend into shade, which is the site's own movement.
import Chamber from "@layouts/Chamber.astro";
import { getLocaleFromUrl, getLocalizedPath, useTranslations } from "@i18n/utils";
import { publicAsset } from "@utils/paths";

const lang = getLocaleFromUrl(Astro.url);
const t = useTranslations(lang);

const years = [
  { year: "2012", key: "obstea.y2012" },
  { year: "2013", key: "obstea.y2013" },
  { year: "2014", key: "obstea.y2014" },
] as const;
---

<Chamber zone="green" title={t("zone.obstea")} lead={t("obstea.lead")} wide>
  <ol class="years">
    {
      years.map(({ year, key }) => (
        <li class="year">
          <figure class="year-plate">
            <img
              src={publicAsset(`/obstea/${year}.webp`)}
              srcset={`${publicAsset(`/obstea/${year}-640.webp`)} 640w, ${publicAsset(`/obstea/${year}.webp`)} 1200w`}
              sizes="(max-width: 1100px) calc(100vw - 32px), 900px"
              alt={`${t("obstea.caption")} ${year}`}
              width="1200"
              height="800"
              loading="lazy"
              decoding="async"
            />
            <figcaption class="year-cap">
              <span class="y">{year}</span>
              <span class="what">{t(key)}</span>
            </figcaption>
          </figure>
        </li>
      ))
    }
  </ol>

  <section class="abbot" aria-labelledby="abbot-head">
    <h2 id="abbot-head">{t("obstea.abbotTitle")}</h2>
    <img
      class="abbot-photo"
      src={publicAsset("/obstea/staretul.webp")}
      alt={t("obstea.abbotName")}
      width="502"
      height="900"
      loading="lazy"
    />
    <p class="abbot-name">{t("obstea.abbotName")}</p>
    <p class="abbot-note">{t("obstea.abbotNote")}</p>
    <p class="links">
      <a href={getLocalizedPath("/staretul", lang)}>{t("zone.staretul")}</a>
      <a href={getLocalizedPath("/mitropolitul", lang)}>{t("zone.mitropolitul")}</a>
      <a href={getLocalizedPath("/slujbe", lang)}>{t("zone.slujbe")}</a>
    </p>
  </section>

  <p class="provenance">{t("obstea.provenance")}</p>
</Chamber>

<style>
  /* The three years run down the shaft as plates, each with its year in the
     seal's lettering and a line on what the photograph shows. No cards. */
  /* doubled class: outranks the chamber's prose list rules */
  .years.years {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--s-10);
  }
  .years .year {
    margin: 0;
    padding: 0;
  }
  .years .year-plate {
    margin: 0;
  }
  .years .year-plate img {
    display: block;
    width: 100%;
    height: auto;
    border: 1px solid #ddd0b2;
  }
  .years .year-cap {
    display: grid;
    justify-items: center;
    gap: var(--s-1);
    margin-top: var(--s-4);
    text-align: center;
    letter-spacing: 0;
    text-transform: none;
  }
  .y {
    font-family: var(--font-display, "Alegreya SC", Georgia, serif);
    font-size: 26px;
    font-weight: 700;
    line-height: 1.2;
    letter-spacing: var(--display-track, 0.08em);
    color: #76633a;
    font-variant-numeric: lining-nums tabular-nums;
  }
  .what {
    max-width: 34rem;
    font-size: var(--t-meta);
    line-height: 1.6;
    font-style: italic;
    color: #4a6274;
  }

  /* the abbot: one portrait on the axis, his name under it */
  .abbot {
    display: grid;
    justify-items: center;
    margin-top: var(--s-11);
    text-align: center;
  }
  .abbot .abbot-photo {
    display: block;
    width: min(256px, 70vw);
    height: auto;
    margin: 0;
    border: 1px solid #ddd0b2;
  }
  .abbot .abbot-name {
    margin: var(--s-5) 0 0;
    font-family: var(--font-display, "Alegreya SC", Georgia, serif);
    font-size: clamp(20px, 1.7vw, 24px);
    font-weight: 700;
    line-height: 1.3;
    letter-spacing: var(--display-track, 0.05em);
    text-transform: var(--display-case, uppercase);
    color: #1a3346;
  }
  .abbot .abbot-note {
    max-width: 30rem;
    margin: var(--s-2) 0 0;
    color: #4a6274;
  }
  .abbot .links {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0 var(--s-6);
    margin: var(--s-5) 0 0;
  }
  .links a {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap);
    font-size: 11px;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: #76633a;
    text-decoration: none;
  }
  .links a:hover {
    text-decoration: underline;
    text-underline-offset: 0.3em;
  }

  .abbot + .provenance {
    max-width: 34rem;
    margin: var(--s-10) auto 0;
    font-size: var(--t-meta);
    line-height: 1.6;
    font-style: italic;
    text-align: center;
    color: #4a6274;
  }
</style>
