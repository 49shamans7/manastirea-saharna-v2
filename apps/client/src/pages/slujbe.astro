---
// TEMPLATE C · TABLE — the hours, verbatim from the monastery's own page.
// Saharna serves two Liturgies on Thursday, Saturday and Sunday, in three
// different churches; that structure is the information, so each day is a
// real table and each Liturgy a block inside it. Today (Europe/Chisinau) is
// warmed and marked by a script; without it every day still reads.
import TableLayout from "@layouts/TableLayout.astro";
import { feasts, schedule, serviceText } from "@data/schedule";
import type { AllTranslationKeys } from "@i18n";
import { getLocaleFromUrl, getLocalizedPath, useTranslations } from "@i18n/utils";

const lang = getLocaleFromUrl(Astro.url);
const t = useTranslations(lang);
const dayName = (key: string) => t(`schedule.${key}` as AllTranslationKeys);
---

<TableLayout title={t("zone.slujbe")} lead={t("slujbe.lead")} mark="bell">
  <nav aria-label={t("table.days")}>
    <ul class="t-days">
      {
        schedule.map((day) => (
          <li>
            <a href={`#zi-${day.key}`} data-day-link={day.key}>
              {dayName(day.key)}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>

  {
    schedule.map((day) => (
      <section class="t-day" id={`zi-${day.key}`} data-day={day.key}>
        <table class="t-hours">
          <caption>
            {dayName(day.key)}
            <span class="t-flag" hidden data-today-flag>
              {t("table.today")}
            </span>
          </caption>
          <thead>
            <tr>
              <th scope="col" class="t-time">
                {t("table.time")}
              </th>
              <th scope="col">{t("table.service")}</th>
            </tr>
          </thead>
          {day.blocks.map((block) => (
            <tbody>
              {block.titleKey && (
                <tr>
                  <th class="t-block" colspan="2" scope="colgroup">
                    {t(block.titleKey as AllTranslationKeys)}
                  </th>
                </tr>
              )}
              {block.services.map((service) => (
                <tr>
                  <td class="t-time">{service.time}</td>
                  <td>
                    {serviceText(service.name, lang)}
                    {service.note && <span class="t-note">{serviceText(service.note, lang)}</span>}
                  </td>
                </tr>
              ))}
            </tbody>
          ))}
        </table>
      </section>
    ))
  }

  <p class="t-small">{t("schedule.caveat")}</p>

  <section class="t-section feasts" aria-labelledby="hramuri">
    <h2 class="t-kicker" id="hramuri">{t("schedule.feastsTitle")}</h2>
    <table class="t-hours">
      <thead>
        <tr>
          <th scope="col">{t("table.date")}</th>
          <th scope="col">{t("table.feast")}</th>
        </tr>
      </thead>
      <tbody>
        {
          feasts.map((feast) => (
            <tr class="is-feast">
              <td class="t-date">{feast.date[lang]}</td>
              <td>{feast.name[lang]}</td>
            </tr>
          ))
        }
      </tbody>
    </table>
    <div class="t-actions">
      <a class="t-btn is-primary" href={getLocalizedPath("/cum-de-ajuns", lang)}>{t("zone.directions")}</a>
      <a class="t-btn" href={getLocalizedPath("/posts", lang)}>{t("zone.cronica")}</a>
    </div>
  </section>
</TableLayout>

<script>
  // today's day, by the monastery's clock
  const weekday = new Intl.DateTimeFormat("en-US", { timeZone: "Europe/Chisinau", weekday: "short" }).format(new Date());
  const key = (
    { Mon: "monWed", Tue: "monWed", Wed: "monWed", Thu: "thu", Fri: "fri", Sat: "sat", Sun: "sun" } as Record<
      string,
      string
    >
  )[weekday];
  const day = document.querySelector<HTMLElement>(`[data-day="${key}"]`);
  if (day) {
    day.classList.add("is-today");
    day.querySelector<HTMLElement>("[data-today-flag]")?.removeAttribute("hidden");
    document.querySelector(`[data-day-link="${key}"]`)?.setAttribute("aria-current", "date");
  }
</script>

<style>
  .feasts {
    margin-top: clamp(48px, 7vh, 72px);
  }
  .t-small {
    margin-top: 0;
  }
</style>
