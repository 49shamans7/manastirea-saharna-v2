---
// TEMPLATE C · TABLE — Zone IV. Contact details: one list of rows, every row
// a tap target (the map, the phones, the mailboxes). Then onward, sideways.
// Numbers and addresses from the old site's own contact page and footer
// (msaharna-archive/text/practical_info.json → _contacts).
import TableLayout from "@layouts/TableLayout.astro";
import Row from "@components/table/Row.astro";
import RiverMark from "@components/marks/RiverMark.astro";
import type { AllTranslationKeys } from "@i18n";
import { getLocaleFromUrl, getLocalizedPath, telHref, useTranslations } from "@i18n/utils";

const lang = getLocaleFromUrl(Astro.url);
const t = useTranslations(lang);
// the old site's exact coordinates of the monastery
const mapQuery = "47.694979,28.965466";
const mapLink = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(mapQuery)}`;
const emails = t("footer.email")
  .split(",")
  .map((address) => address.trim())
  .filter(Boolean);

const phones = [
  { label: t("contact.secretariatLabel"), number: t("contact.phoneSecretariat") },
  { label: t("contact.phoneMainLabel"), number: t("contact.phoneMain") },
  { label: t("contact.guesthouseLabel"), number: t("contact.phoneMobile"), note: t("contact.guesthouseHours") },
];

const onward: { href: string; labelKey: AllTranslationKeys; mark: "pin" | "arch" | "lamp" | "hands" }[] = [
  { href: "/cum-de-ajuns", labelKey: "zone.directions", mark: "pin" },
  { href: "/cazare", labelKey: "zone.cazare", mark: "arch" },
  { href: "/pomelnic", labelKey: "zone.pomelnic", mark: "lamp" },
  { href: "/donations", labelKey: "nav.donations", mark: "hands" },
];
---

<TableLayout title={t("nav.contact")} lead={t("directions.lead")} mark="bell">
  <section class="t-section" aria-labelledby="adresa">
    <h2 class="t-kicker" id="adresa">{t("contact.addressLabel")}</h2>
    <ul class="t-rows">
      <Row label={t("footer.addressName")} href={mapLink} external mark="pin" literal>
        {t("footer.addressLine")}
      </Row>
    </ul>
  </section>

  <section class="t-section" aria-labelledby="telefon">
    <h2 class="t-kicker" id="telefon">{t("contact.phoneMainLabel")}</h2>
    <ul class="t-rows">
      {
        phones.map((phone) => (
          <Row label={phone.label} href={telHref(phone.number)} mark="bell" note={phone.note} literal>
            {phone.number}
          </Row>
        ))
      }
    </ul>
  </section>

  <section class="t-section" aria-labelledby="email">
    <h2 class="t-kicker" id="email">{t("contact.emailLabel")}</h2>
    <ul class="t-rows">
      {
        emails.map((address) => (
          <Row label={t("contact.emailLabel")} href={`mailto:${address}`} literal>
            {address}
          </Row>
        ))
      }
    </ul>
  </section>

  <section class="t-section" aria-labelledby="mai-departe">
    <h2 class="t-kicker" id="mai-departe">{t("table.onward")}</h2>
    <ul class="r-drift t-drift">
      {
        onward.map((item) => (
          <li>
            <a class="t-card" href={getLocalizedPath(item.href, lang)}>
              <RiverMark name={item.mark} />
              <span class="t-card-title">{t(item.labelKey)}</span>
              <span class="t-card-go" aria-hidden="true">
                →
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>
</TableLayout>
