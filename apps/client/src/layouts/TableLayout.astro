---
// TEMPLATE C · TABLE — practical information, Zone IV. The river's layout
// (design/prototypes/templates/table.html): a navy horizon band at the top
// carrying the seal's folk band, a centred head in big capitals, then data as
// real tables and label · value rows, and the parallel options drifting
// sideways on a phone. v1's colours: white ground, navy ink, gold line work.
// Reads fast on a phone in a car park; prints clean.
import Layout from "@layouts/Layout.astro";
import TempleFrame from "@layouts/TempleFrame.astro";
import RiverMark, { type RiverMarkName } from "@components/marks/RiverMark.astro";
import divider from "@assets/ornaments/divider.svg?raw";
import { getLocaleFromUrl, useTranslations } from "@i18n/utils";
import type { ZoneId } from "@temple/zones";
import "@styles/temple.css";
import "@components/table/table.css";

interface Props {
  title: string;
  /** The tracked line above the title. Defaults to "Zona IV · Nistru". */
  kicker?: string | undefined;
  lead?: string | undefined;
  /** A constructed mark beside the kicker (pin, bell, hands, arch, lamp…). */
  mark?: RiverMarkName | undefined;
  /** The stratum the rails mark as current. Tables are the river; the
      pomelnic wears this head but is the well of Zone I. */
  zone?: ZoneId | undefined;
}

const { title, kicker, lead, mark, zone = "river" } = Astro.props;
const lang = getLocaleFromUrl(Astro.url);
const t = useTranslations(lang);
const eyebrow = kicker ?? t("table.zoneRiver");
const ornament = divider
  .replace(/<!--.*?-->/gs, "")
  .replace(/\swidth="\d+"\sheight="\d+"/, ' aria-hidden="true" focusable="false"');
---

<Layout title={title} description={lead}>
  <div class="t-horizon" aria-hidden="true"></div>
  <div class="t-ground">
    <TempleFrame lang={lang} zone={zone} path={Astro.url.pathname}>
      <main class="t-page table-page">
        <header class="t-head">
          <p class="r-eyebrow">
            {mark && <RiverMark name={mark} />}
            <span>{eyebrow}</span>
          </p>
          <h1 class="r-title is-page">{title}</h1>
          <span class="t-ornament" set:html={ornament} />
          {lead && <p class="r-lead">{lead}</p>}
        </header>
        <div class="t-body">
          <slot />
        </div>
      </main>
    </TempleFrame>
  </div>
</Layout>

<style>
  /* the frame's river ground becomes v1's white, its hairlines the seal's */
  .t-ground :global(.frame) {
    background: #fff;
    color: #1a3346;
    --line: #ddd0b2;
    --line-strong: #ab9362;
    --kicker: #76633a;
    --here: #22425a;
  }

  .table-page {
    padding: clamp(40px, 7vh, 72px) 0 var(--page-bottom);
    max-width: 60rem;
    margin-inline: auto;
  }

  /* ── prose that arrives from markdown (the guest house rules) ──────
     Only unclassed elements: the table components carry their own. */
  .t-body {
    font-size: 17px;
    line-height: 1.7;
  }
  .t-body :global(p:not([class])) {
    max-width: 40rem;
    margin: 0 0 1.05em;
    text-wrap: pretty;
  }
  .t-body :global(h2:not([class])),
  .t-body :global(h3:not([class])) {
    margin: clamp(48px, 7vh, 72px) 0 16px;
    font-size: 11px;
    font-weight: 400;
    line-height: 1.5;
    letter-spacing: 0.4em;
    text-transform: uppercase;
    color: var(--t-soft);
  }
  .t-body > :global(:first-child h2:first-child),
  .t-body > :global(h2:first-child) {
    margin-top: 0;
  }
  .t-body :global(a:not([class*="t-"])) {
    color: var(--t-deep);
    text-decoration: underline;
    text-decoration-color: var(--t-edge);
    text-decoration-thickness: 1px;
    text-underline-offset: 0.2em;
  }
  .t-body :global(a:not([class*="t-"]):hover) {
    text-decoration-color: currentColor;
  }
  .t-body :global(a.tap) {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    max-width: 100%;
    overflow-wrap: anywhere;
  }

  /* a numbered list of rules is a table of rows: white, hairlines,
     the number in gold on tabular figures */
  .t-body :global(ol:not([class])) {
    margin: 0 0 1.4em;
    padding: 0;
    list-style: none;
    counter-reset: t-rule;
    background: #fff;
    border: 1px solid var(--t-edge);
  }
  .t-body :global(ol:not([class]) > li) {
    position: relative;
    min-height: var(--t-row);
    padding: 14px var(--t-pad-x) 14px calc(var(--t-pad-x) + 36px);
    counter-increment: t-rule;
  }
  .t-body :global(ol:not([class]) > li + li) {
    border-top: 1px solid var(--t-edge);
  }
  .t-body :global(ol:not([class]) > li::before) {
    content: counter(t-rule, decimal-leading-zero);
    position: absolute;
    left: var(--t-pad-x);
    top: 16px;
    font-size: 14px;
    letter-spacing: 0.08em;
    font-variant-numeric: lining-nums tabular-nums;
    color: var(--t-ochre-ink);
  }
  .t-body :global(ul:not([class])) {
    max-width: 40rem;
    margin: 0 0 1.4em;
    padding-left: 1.2em;
    list-style: square;
  }
  .t-body :global(ul:not([class]) > li::marker) {
    color: var(--t-ochre);
  }

  /* a markdown definition list: label · value rows */
  .t-body :global(dl:not([class])) {
    display: grid;
    grid-template-columns: 200px minmax(0, 1fr);
    margin: 0 0 1.4em;
    background: #fff;
    border: 1px solid var(--t-edge);
    border-bottom: 0;
  }
  .t-body :global(dl:not([class]) > dt),
  .t-body :global(dl:not([class]) > dd) {
    margin: 0;
    padding: 14px var(--t-pad-x);
    border-bottom: 1px solid var(--t-edge);
  }
  .t-body :global(dl:not([class]) > dt) {
    font-size: 11px;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: var(--t-soft);
  }
  @media (max-width: 599px) {
    .t-body :global(dl:not([class])) {
      grid-template-columns: minmax(0, 1fr);
    }
    .t-body :global(dl:not([class]) > dt) {
      padding-bottom: 0;
      border-bottom: 0;
    }
  }

  @media print {
    .t-ground :global(.frame) {
      background: #fff;
    }
  }
</style>
