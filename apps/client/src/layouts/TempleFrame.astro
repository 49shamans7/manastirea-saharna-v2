---
// THE FRAME — a centre field between two rails, from Page 1 and from the old
// site's own lfon_repeat / rfon_repeat margin tiles. Every page that is not
// the descent itself sits inside this.
//
// v2 "river": the frame runs edge to edge. No boxes, no centred card — the
// left rail is a depth gauge (one field wide, four markers, the zone you are
// in filled gold), the centre is the seal's white field with the page's own
// column centred in it, the right rail is the calendar's gold field. On a
// phone the gauge lies down into a strip above the page and the calendar
// follows the text.
import DescentRail from "@components/temple/DescentRail.astro";
import CalendarRail from "@components/temple/CalendarRail.astro";
import type { Locale } from "@i18n";
import type { ZoneId } from "@temple/zones";

interface Props {
  lang: Locale;
  zone: ZoneId;
  path?: string;
  /** The descent hides the rails' chrome; chambers and tables show them. */
  rails?: boolean;
}

const { lang, zone, path = "", rails = true } = Astro.props;
---

<div class:list={["frame", "ground-white", `z-${zone}`, !rails && "no-rails"]} data-zone={zone}>
  {rails && <DescentRail lang={lang} current={zone} path={path} />}
  <div class="centre">
    <slot />
  </div>
  {rails && <CalendarRail lang={lang} placement="rail" />}
</div>

<style>
  /* gauge | field | calendar. The field takes what is left; the page's own
     column is centred inside it, so the text sits on the axis of the screen
     at every width, as in the chamber prototype. */
  .frame {
    display: grid;
    grid-template-columns: var(--rail-l) minmax(0, 1fr) var(--rail-r);
    grid-template-areas: "left centre right";
    min-height: calc(100dvh - var(--nav-h, 80px));
    background: #ffffff;
    color: var(--seal-paper);
  }
  .frame.no-rails {
    grid-template-columns: minmax(0, 1fr);
    grid-template-areas: "centre";
  }
  .frame > :global(.rail-left) {
    grid-area: left;
  }
  .frame > :global(.rail-right) {
    grid-area: right;
  }
  .centre {
    grid-area: centre;
    min-width: 0;
    padding: 0 var(--frame-pad);
  }
  /* the page's column, whatever its measure, sits on the field's axis */
  .centre > :global(main) {
    width: 100%;
    margin-inline: auto;
  }

  /* the calendar outranks nothing beside the text below 1360px: it follows
     the text, folded, in the field's column; the gauge keeps its rail */
  @media (max-width: 1360px) {
    .frame {
      grid-template-columns: var(--rail-l) minmax(0, 1fr);
      grid-template-rows: auto auto;
      grid-template-areas:
        "left centre"
        "left right";
    }
  }
  /* a phone: the gauge lies down into a strip above the page */
  @media (max-width: 1100px) {
    .frame {
      grid-template-columns: minmax(0, 1fr);
      grid-template-rows: auto 1fr auto;
      grid-template-areas:
        "left"
        "centre"
        "right";
    }
  }
</style>
