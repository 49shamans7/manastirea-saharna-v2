---
// THE FRAME — a centre field between two rails, from Page 1 and from the old
// site's own lfon_repeat / rfon_repeat margin tiles. Every page that is not
// the descent itself sits inside this.
//
// v2 "river": the frame runs edge to edge. No boxes, no centred card — the
// left rail is a depth gauge (one field wide, four markers, the zone you are
// in filled gold), the centre is the seal's white field with the page's own
// column centred in it, the right rail is the calendar's gold field. On a
// phone the gauge lies down into a strip above the page and the calendar
// follows the text.
import Icon from "@components/marks/Icon.astro";
import type { Locale } from "@i18n";
import { getLocalizedPath, useTranslations } from "@i18n/utils";
import type { ZoneId } from "@temple/zones";

interface Props {
  lang: Locale;
  zone: ZoneId;
  path?: string;
  /** The descent hides the rails' chrome; chambers and tables show them. */
  rails?: boolean;
}

const { lang, zone, rails = true } = Astro.props;
const t = useTranslations(lang);
---

<div class:list={["frame", "ground-white", `z-${zone}`, !rails && "no-rails"]} data-zone={zone}>
  <div class="centre">
    {
      rails && (
        <a class="back-home" href={getLocalizedPath("/", lang)}>
          <Icon name="arrow-left" size={22} />
          <span>{t("nav.backHome")}</span>
        </a>
      )
    }
    <slot />
  </div>
</div>

<style>
  .frame {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    grid-template-areas: "centre";
    min-height: calc(100dvh - var(--nav-h, 80px));
    background: var(--gloss-cream);
    color: var(--seal-paper);
  }
  .centre {
    grid-area: centre;
    min-width: 0;
    padding: 0 var(--frame-pad);
  }
  .centre > :global(main) {
    width: 100%;
    margin-inline: auto;
  }

  /* the way home: first thing on every inner page, in words */
  .back-home {
    display: inline-flex;
    align-items: center;
    gap: var(--s-2);
    min-height: var(--tap);
    margin-top: var(--s-3);
    color: #1a3346;
    font-size: var(--t-ui);
    font-weight: 500;
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 0.2em;
  }
</style>
