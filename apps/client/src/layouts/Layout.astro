---
import Navbar from "@components/Navbar.astro";
import SiteFooter from "@components/SiteFooter.astro";
import RailDrawer from "@components/temple/RailDrawer.astro";
import Icon from "@components/marks/Icon.astro";
import { locales, type Locale } from "@i18n";
import { getLocaleFromUrl, getLocalizedPath, useTranslations } from "@i18n/utils";
import { publicAsset } from "@utils/paths";

import "@styles/global.css";

interface Props {
  /** Page name. The site name is appended; the home page passes nothing. */
  title?: string;
  /** One sentence for search results and link previews; defaults to the site's. */
  description?: string | undefined;
}

const lang = getLocaleFromUrl(Astro.url);
const t = useTranslations(lang);
const faviconHref = publicAsset("/favicon.ico");
const siteTitle = t("main.title");
// "Page — Sfânta Mănăstire Saharna" (WCAG 2.4.2: every page names itself)
// (the three-line logo name is Romanian in every locale; en/ru keep their own)
const houseName =
  lang === "ro" ? [t("main.logoLineOne"), t("main.logoLineTwo"), t("main.logoLineThree")].join(" ") : siteTitle;
const pageTitle =
  Astro.props.title && Astro.props.title !== siteTitle ? `${Astro.props.title} — ${houseName}` : siteTitle;
const description = Astro.props.description?.trim() || t("main.description");
// absolute URLs for search engines and link previews (site + base path)
const absolute = (path: string) => new URL(path, Astro.site).href;
const canonical = absolute(Astro.url.pathname);
const alternates = (Object.keys(locales) as Locale[]).map((code) => ({
  code,
  href: absolute(getLocalizedPath(Astro.url.pathname, code)),
}));
const ogLocale = { ro: "ro_RO", en: "en_US", ru: "ru_RU" }[lang];
const ogImage = absolute(publicAsset("/og.jpg"));

// The seal's lettering: Alegreya SC 500/700, self-hosted (OFL, public/fonts),
// split by script so a page loads only what it prints. Headings only;
// Georgia stays the text face. Latin, Romanian ș ț and Cyrillic.
const fontRanges = {
  latin:
    "U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD",
  "latin-ext":
    "U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C0, U+2113, U+2C60-2C7F, U+A720-A7FF",
  cyrillic: "U+0301, U+0400-045F, U+0490-0491, U+04B0-04B1, U+2116",
};
const fontFaces = [500, 700]
  .flatMap((weight) =>
    Object.entries(fontRanges).map(
      ([subset, range]) =>
        `@font-face{font-family:"Alegreya SC";font-style:normal;font-weight:${weight};font-display:swap;src:url("${publicAsset(`/fonts/alegreya-sc-${subset}-${weight}-normal.woff2`)}") format("woff2");unicode-range:${range}}`,
    ),
  )
  .join("");
// The gothic display voice: Pirata One (Latin) and Monomakh (Cyrillic), one
// family. Regular weight only; it is drawn heavy.
const gothicFaces = [
  [
    "pirata-one-latin",
    "U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD",
  ],
  [
    "pirata-one-latin-ext",
    "U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C0, U+2113, U+2C60-2C7F, U+A720-A7FF",
  ],
  ["monomakh-cyrillic", "U+0301, U+0400-045F, U+0490-0491, U+04B0-04B1, U+2116"],
]
  .map(
    ([file, range]) =>
      `@font-face{font-family:"Saharna Gothic";font-style:normal;font-weight:400;font-display:swap;src:url("${publicAsset(`/fonts/${file}.woff2`)}") format("woff2");unicode-range:${range}}`,
  )
  .join("");
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="darkreader-lock" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {alternates.map((alt) => <link rel="alternate" hreflang={alt.code} href={alt.href} />)}
    <link rel="alternate" hreflang="x-default" href={alternates.find((alt) => alt.code === "ro")?.href} />
    <link rel="alternate" type="application/rss+xml" title={siteTitle} href={absolute(publicAsset("/rss.xml"))} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteTitle} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content={ogLocale} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" href={faviconHref} sizes="any" />
    <link rel="icon" href={publicAsset("/favicon.svg")} type="image/svg+xml" />
    <link rel="icon" href={publicAsset("/icon-192.png")} type="image/png" sizes="192x192" />
    <link rel="apple-touch-icon" href={publicAsset("/apple-touch-icon.png")} />
    <link rel="manifest" href={publicAsset("/site.webmanifest")} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="theme-color" content="#253528" />
    {/* lets CSS hold scroll-revealed strata back only when a script will bring them in */}
    <script is:inline>
      document.documentElement.classList.add("js");
    </script>

    <link
      rel="preload"
      href={publicAsset("/fonts/alegreya-sc-latin-700-normal.woff2")}
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link rel="preload" href={publicAsset("/fonts/pirata-one-latin.woff2")} as="font" type="font/woff2" crossorigin />
    <style set:html={fontFaces + gothicFaces} />

    <title>{pageTitle}</title>
    {
      Astro.url.pathname === getLocalizedPath("/", lang) && (
        <script
          type="application/ld+json"
          set:html={JSON.stringify({
            "@context": "https://schema.org",
            "@type": "PlaceOfWorship",
            name: siteTitle,
            url: absolute(getLocalizedPath("/", lang)),
            telephone: t("contact.phoneMain"),
            email: t("footer.email").split(",")[0]?.trim(),
            address: {
              "@type": "PostalAddress",
              addressLocality: "Saharna",
              addressRegion: "Rezina",
              postalCode: "MD-5431",
              addressCountry: "MD",
            },
            geo: { "@type": "GeoCoordinates", latitude: 47.694979, longitude: 28.965466 },
          })}
        />
      )
    }
  </head>
  <body id="sus">
    <a class="skip" href="#continut">{t("nav.skip")}</a>
    <Navbar path={Astro.url.pathname} lang={lang} />
    <span id="continut"></span>
    <slot />
    <SiteFooter lang={lang} />
    <RailDrawer lang={lang} path={Astro.url.pathname} />
    <a class="to-top" href="#sus" data-to-top>
      <Icon name="arrow-up" size={22} />
      <span>{t("nav.toTop")}</span>
    </a>
    <script>
      // "În sus": shown once the reader is a screen and a half down
      const top = document.querySelector<HTMLElement>("[data-to-top]");
      if (top) {
        const update = () => top.classList.toggle("is-on", window.scrollY > window.innerHeight * 1.5);
        window.addEventListener("scroll", update, { passive: true });
        update();
      }
    </script>
    <style is:global>
      .skip {
        position: fixed;
        top: 8px;
        left: 8px;
        z-index: 100;
        padding: 12px 16px;
        background: #1a3346;
        color: #fffdf8;
        font-size: 18px;
        transform: translateY(-200%);
      }
      .skip:focus {
        transform: none;
      }
      #continut {
        display: block;
        scroll-margin-top: var(--nav-h, 80px);
      }
      .to-top {
        position: fixed;
        right: 16px;
        bottom: max(16px, env(safe-area-inset-bottom));
        z-index: 40;
        display: none;
        align-items: center;
        gap: 6px;
        min-height: 56px;
        padding: 0 16px;
        border: 2px solid #e2cf9f;
        background: #1a3346;
        color: #fffdf8;
        font-size: 18px;
        font-weight: 700;
        text-decoration: none;
      }
      .to-top.is-on {
        display: inline-flex;
      }
      @media print {
        .to-top {
          display: none;
        }
      }
    </style>
  </body>
</html>
