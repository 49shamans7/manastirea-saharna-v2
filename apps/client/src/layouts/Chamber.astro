---
// TEMPLATE B · CHAMBER — a room you enter. On the seal's navy; one centred
// column under one centred head. The gold skin is the shrine: narrower
// measure, thread-gold versal, the deeper navy as ground, rubrics in the
// liturgical colour, and nothing moves.
import Layout from "@layouts/Layout.astro";
import TempleFrame from "@layouts/TempleFrame.astro";
import { getLocaleFromUrl, getLocalizedPath, useTranslations } from "@i18n/utils";
import type { ZoneId } from "@temple/zones";
import "@styles/temple.css";

interface Props {
  zone: ZoneId;
  title: string;
  /** A short line above the title, only where it orients the reader (a
      post's date). Zone names are not passed: the rails already say where
      you are. */
  eyebrow?: string | undefined;
  lead?: string | undefined;
  /** Plate behind the chamber head, if one exists for this zone. */
  plate?: string | undefined;
  /** False where the page ends with its own way back (a post's "all news"),
      so the reader is not offered two exits stacked on each other. */
  backLink?: boolean;
}

const { zone, title, eyebrow, lead, plate, backLink = true } = Astro.props;
const lang = getLocaleFromUrl(Astro.url);
const t = useTranslations(lang);
const isGold = zone === "gold";
// a long title (most cronică entries) steps down one size instead of
// shouting across three lines
const isLong = title.length > 48;
// Return lands on the descent at this zone's depth, never at the top — and it
// must work without JavaScript, so it is written here, not patched in later.
const descentHref = `${getLocalizedPath("/", lang)}#zona-${zone}`;
---

<Layout title={title} description={lead}>
  <TempleFrame lang={lang} zone={zone} path={Astro.url.pathname}>
    <main class:list={["chamber", isGold && "is-shrine"]}>
      <header class="page-head chamber-head">
        {plate && <img class="head-plate" src={plate} alt="" aria-hidden="true" loading="eager" />}
        {eyebrow && <p class="page-kicker">{eyebrow}</p>}
        <h1 class:list={["page-title chamber-title", isLong && "is-long"]}>{title}</h1>
        {lead && <p class="page-lead">{lead}</p>}
      </header>


      <div class="chamber-body">
        <slot />
      </div>

      {
        backLink && (
          <footer class="chamber-foot">
            <a class="back" href={descentHref}><span aria-hidden="true">←</span> {t("zone.backToDescent")}</a>
          </footer>
        )
      }
    </main>
  </TempleFrame>
</Layout>

<script>
  // A ruled table wider than a phone scrolls inside itself; a keyboard must
  // be able to reach that scroll too (WCAG 2.1.1).
  const markScrollable = () =>
    document.querySelectorAll<HTMLTableElement>(".chamber-body table").forEach((table) => {
      if (table.scrollWidth > table.clientWidth + 1) table.tabIndex = 0;
      else table.removeAttribute("tabindex");
    });
  markScrollable();
  window.addEventListener("resize", markScrollable, { passive: true });
</script>

<style>
  /* a title in capitals is never broken by a hyphen */
  .chamber :global(.page-title) {
    hyphens: manual;
  }
  .chamber {
    padding: var(--page-top) 0 var(--page-bottom);
    /* one centred column under one centred head */
    max-width: var(--measure-wide, 62rem);
    margin-inline: auto;
  }
  .is-shrine {
    max-width: calc(var(--measure-gold) + 6rem);
  }

  /* a plate is cut to the head's own box — hard edges, no feather; the
     ground lies over it as one flat layer */
  .head-plate {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.42;
    z-index: -1;
  }
  /* shrine titles are navy like every other page (owner, 2026-10-10); the
     shrine keeps its narrower measure and gold sub-heads */

  .chamber-body {
    max-width: var(--measure);
    margin-inline: auto;
    font-size: var(--t-body);
    line-height: var(--lh-body);
  }
  .is-shrine .chamber-body {
    max-width: var(--measure-gold);
  }
  .chamber-body :global(p) {
    margin: 0 0 1.05em;
    text-wrap: pretty;
  }
  .chamber-body :global(h2) {
    font-family: var(--font-display);
    font-size: var(--t-h2);
    font-weight: 700;
    text-align: center;
    line-height: 1.3;
    letter-spacing: var(--track-caps);
    text-transform: uppercase;
    text-wrap: balance;
    margin: var(--s-9) 0 var(--s-4);
  }
  /* a section opens on a short solid bar — the one ornament in the text */
  .chamber-body :global(h2)::before {
    content: "";
    display: block;
    width: var(--s-6);
    height: var(--rule-2);
    background: var(--line-strong);
    margin: 0 auto var(--s-4);
  }
  .chamber-body > :global(:first-child) > :global(h2:first-child),
  .chamber-body > :global(h2:first-child) {
    margin-top: 0;
  }
  /* sub-heads inside a chamber: Slujba's cântări, the Life's chapters and
     testimonies. One step down from h2, then one more; still line work. */
  .chamber-body :global(h3) {
    text-align: center;
    font-size: var(--t-h3);
    font-weight: 400;
    font-style: italic;
    line-height: 1.4;
    margin: var(--s-7) 0 var(--s-2);
    color: var(--ochre);
  }
  .chamber-body :global(h4) {
    font-size: var(--t-body);
    font-weight: 700;
    line-height: 1.45;
    margin: var(--s-6) 0 var(--s-2);
  }
  /* Rubrics — the service's own instructions (bold-italic in the source) —
     are printed red in a liturgical book. In the shrine that red is the
     living half of the pall palette (#BD639A), lifted one step so it holds
     4.5:1 on the pall ground. */
  .is-shrine .chamber-body :global(strong em),
  .is-shrine .chamber-body :global(em strong) {
    color: var(--rubric);
    font-weight: 400;
  }
  .is-shrine .chamber-body :global(h3) {
    color: var(--gold);
  }
  .chamber-body :global(h2 + h3),
  .chamber-body :global(h3 + h4) {
    margin-top: var(--s-3);
  }

  /* verse with hard line breaks: keep each line whole where it fits, wrap
     cleanly where it does not */
  .chamber-body :global(p) {
    overflow-wrap: break-word;
  }

  .chamber-body :global(blockquote) {
    margin: var(--s-7) 0;
    padding-left: var(--s-5);
    border-left: var(--rule-2) solid var(--line-strong);
    font-style: italic;
    font-size: var(--t-quote);
    line-height: 1.6;
  }
  /* the reset strips markers; lists in a chamber are real lists */
  .chamber-body :global(ul),
  .chamber-body :global(ol) {
    margin: 0 0 1.3em;
    padding-left: 1.4em;
  }
  .chamber-body :global(ul) {
    list-style: disc;
  }
  .chamber-body :global(ol) {
    list-style: decimal;
  }
  .chamber-body :global(ul ul) {
    list-style: circle;
    margin: 0.4em 0 0;
  }
  .chamber-body :global(li) {
    margin-bottom: 0.5em;
    padding-left: 0.2em;
  }
  .chamber-body :global(li::marker) {
    color: var(--ochre);
  }
  .is-shrine .chamber-body :global(li::marker) {
    color: var(--gold);
  }
  .chamber-body :global(li > p) {
    margin-bottom: 0.4em;
  }

  /* tables (Istoria's abbots): full measure, ruled, numbers aligned. On a
     phone the table scrolls inside itself, never the page. */
  .chamber-body :global(table) {
    display: block;
    width: 100%;
    max-width: 100%;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    border-collapse: collapse;
    margin: 1.6em 0 2em;
    font-size: 0.94em;
    line-height: 1.5;
    font-variant-numeric: tabular-nums;
  }
  .chamber-body :global(th),
  .chamber-body :global(td) {
    text-align: left;
    vertical-align: top;
    padding: var(--s-2) var(--s-4);
    border-bottom: var(--rule) solid var(--line);
  }
  .chamber-body :global(th:first-child),
  .chamber-body :global(td:first-child) {
    padding-left: 0;
  }
  .chamber-body :global(th) {
    font-weight: 400;
    font-size: var(--t-meta);
    line-height: 1.35;
    vertical-align: bottom;
    padding-bottom: var(--s-2);
    color: var(--ochre);
    border-bottom: var(--rule) solid var(--line-strong);
  }
  @media (max-width: 767px) {
    .chamber-body :global(th),
    .chamber-body :global(td) {
      padding: 0.35em 0.55em;
    }
  }
  .chamber-body :global(td) {
  }

  .chamber-body :global(hr) {
    border: 0;
    height: var(--rule);
    width: 100%;
    margin: var(--s-8) 0;
    background: var(--line);
  }
  /* CHRONOLOGY — a ruled table of dates. The date is a label in a fixed
     column, the event reads beside it; a hairline under every entry, the
     emphasis rule over the first. On a phone the date stands above. */
  .chamber-body :global(dl.chronology) {
    display: grid;
    grid-template-columns: 176px minmax(0, 1fr);
    column-gap: var(--s-5);
    margin: var(--s-6) 0 var(--s-8);
    border-top: var(--rule) solid var(--line-strong);
    font-variant-numeric: lining-nums tabular-nums;
  }
  /* first thing under the head: the head's rule already opens it */
  .chamber-body :global(dl.chronology:first-child) {
    border-top: 0;
  }
  .chamber-body :global(dl.chronology:first-child > dt:first-of-type),
  .chamber-body :global(dl.chronology:first-child > dd:first-of-type) {
    padding-top: 0;
  }
  .chamber-body :global(dl.chronology dt),
  .chamber-body :global(dl.chronology dd) {
    margin: 0;
    padding: var(--s-3) 0;
    border-bottom: var(--rule) solid var(--line);
    min-width: 0;
  }
  .chamber-body :global(dl.chronology dt) {
    font-size: var(--t-body);
    line-height: 1.7;
    color: var(--ochre);
  }
  .chamber-body :global(dl.chronology dt strong) {
    font-weight: 400;
  }
  .chamber-body :global(dl.chronology dd) {
    line-height: 1.7;
    overflow-wrap: break-word;
  }
  @media (max-width: 599px) {
    .chamber-body :global(dl.chronology) {
      grid-template-columns: minmax(0, 1fr);
    }
    .chamber-body :global(dl.chronology dt) {
      padding-bottom: 0;
      border-bottom: 0;
    }
    .chamber-body :global(dl.chronology dd) {
      padding-top: var(--s-1);
    }
  }

  /* FIGURE — a plate set into the wall: square, flat, no shadow. The caption
     is a label, cut off from the text by a hairline. */
  .chamber-body :global(figure) {
    margin: var(--s-6) 0 var(--s-8);
  }
  .chamber-body :global(figure img) {
    display: block;
    margin: 0;
    border-radius: var(--radius);
  }
  .chamber-body :global(figcaption) {
    margin-top: var(--s-3);
    font-size: var(--t-meta);
    line-height: 1.55;
    font-style: italic;
    color: var(--seal-mist);
    max-width: var(--measure);
  }

  .chamber-body :global(a) {
    color: var(--ochre);
    text-decoration: underline;
    text-decoration-thickness: var(--rule);
    text-decoration-color: var(--seal-gold);
    text-underline-offset: 0.2em;
    transition: text-decoration-color var(--dur-1) var(--ease-out);
  }
  .chamber-body :global(a:hover) {
    text-decoration-color: currentColor;
  }
  .chamber-body :global(img) {
    width: 100%;
    height: auto;
    margin: 2em 0;
  }

  .chamber-foot {
    margin-top: var(--s-10);
    padding-top: var(--s-3);
    border-top: var(--rule) solid var(--line);
  }
  .back {
    display: inline-flex;
    align-items: center;
    gap: var(--s-2);
    min-height: var(--tap);
    font-size: var(--t-ui);
    color: var(--ochre);
    text-decoration: none;
  }
  .back:hover {
    text-decoration: underline;
    text-decoration-thickness: var(--rule);
    text-underline-offset: 0.25em;
  }
</style>
