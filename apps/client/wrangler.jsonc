// Cloudflare Workers — static assets only (no Worker script), the approach
// Cloudflare recommends for a fully static Astro site (2026: Workers static
// assets; Pages is maintained but new projects go to Workers).
//
// NOT DEPLOYED YET. `bun run cloudflare:setup` deploys it on the monastery's
// own account (docs/CLOUDFLARE-HANDOVER.md). After that:
//
//   bunx wrangler deploy                     # runs build.command, uploads ./dist
//   bunx wrangler dev                        # local preview with _headers/_redirects
//
// _headers and _redirects in public/ are copied into dist/ by the build and
// honoured by Workers static assets as they are by Pages.
{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "manastirea-saharna",
  "compatibility_date": "2026-10-01",

  // The site at the domain root: BASE_PATH=/ and SITE_URL=https://manastirea-saharna.md
  // (canonical URLs, sitemap, RSS). The GitHub Pages build keeps its own
  // defaults (/manastirea-saharna-v2) until Pages is switched off.
  "build": {
    "command": "bun run build:cloudflare",
    "cwd": ".",
    "watch_dir": "src",
  },

  "assets": {
    "directory": "./dist",
    // /foo → 307 /foo/ when foo/index.html exists (Astro: trailingSlash always)
    "html_handling": "auto-trailing-slash",
    // unknown paths → dist/404.html with status 404
    "not_found_handling": "404-page",
  },

  // *.workers.dev stays on as the preview address until the custom domain is live.
  "workers_dev": true,
  "preview_urls": false,

  // No "routes" here on purpose. The custom domains are attached once, with
  // confirmation, by scripts/cloudflare-setup.mjs (`wrangler deploy --domain`),
  // and later deploys leave them in place. In CI, wrangler would overwrite
  // conflicting DNS records without asking if they were listed here.
}
